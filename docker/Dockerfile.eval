FROM nvidia/cuda:12.4.1-runtime-ubuntu22.04

# 0. Environment
ARG PY_VER=3.12
ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONIOENCODING=utf8 \
    PIP_NO_CACHE_DIR=1

# 1. System packages + Python 3.12
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
          software-properties-common curl ca-certificates && \
    add-apt-repository -y ppa:deadsnakes/ppa && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
          python${PY_VER} python${PY_VER}-distutils python3-pip && \
    ln -sf /usr/bin/python${PY_VER} /usr/local/bin/python && \
    python -m pip install --upgrade pip && \
    rm -rf /var/lib/apt/lists/*

# 2. Python deps
WORKDIR /workspace
COPY Docker_requirements.txt .
RUN sed -i 's/+cu124//' Docker_requirements.txt && \
    python -m pip install -r Docker_requirements.txt && \
    pip cache purge

# 3. Entrypoint 
COPY docker/seccomp_profile.json /etc/seccomp_profile.json
COPY docker/predict.sh /usr/local/bin/predict.sh
RUN chmod +x /usr/local/bin/predict.sh

# 4. Non-root user
RUN useradd -m -s /bin/bash sandbox
USER sandbox
ENTRYPOINT ["/usr/local/bin/predict.sh"]

# to build the image      :   docker build -f docker/Dockerfile.eval -t llm-evaluation-sandbox:latest .