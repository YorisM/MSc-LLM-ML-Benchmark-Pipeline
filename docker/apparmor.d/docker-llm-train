#include <tunables/global>

profile docker_llm_train flags=(attach_disconnected,mediate_deleted) {
  # 0) Generic safe defaults ------------------------------------------------
  deny /** rwklx,            # no read, write, link, exec anywhere
  deny /**/ rwklx,

  # 1) Allow read-only datasets --------------------------------------------
  allow /data/train/** r,
  allow /data/val/**   r,

  # 2) Allow GPU device nodes & tmpfs scratch -------------------------------
  allow /dev/nvidia* rw,
  allow /dev/shm/**  rw,
  allow /tmp/**      rw,

  # 3) Allow the *exact* artefact filenames in /workspace/out ---------------
  allow /workspace/out/*_state.pt      rw,
  allow /workspace/out/*_model.pkl     rw,
  allow /workspace/out/*_preproc.pkl   rw,
  allow /workspace/out/*_accuracy.png  rw,
  allow /workspace/out/*_loss.png      rw,

  # 4) Allow the interpreter + libs to be read/executed ---------------------
  allow /usr/** rix,
  allow /lib/** rix,
}
