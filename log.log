# 0. ---------- IMPORTS ----------
import torch
import numpy as np
from torch import nn
from torch.utils.data import Dataset, DataLoader
from sklearn.metrics import roc_auc_score
from torch.optim.lr_scheduler import ReduceLROnPlateau
import torch.nn.functional as F

# 1. ---------- PRE-PROCESSING ----------
class MyPreprocessor:
    def __init__(self):
        self.eps = 1e-8
        self.has_fit = False
        self.medians = None

    def fit(self, X, y=None):
        # Compute median for each feature (except object types) to handle zeros (padding)
        # Only fit on non-zero values where feature index mod 5 is not 0 (object type)
        X_flat = X.view(-1, X.shape[-1])
        mask = torch.zeros(X_flat.shape, dtype=bool)
        # Create mask for valid features (all except object type columns)
        for j in range(X_flat.shape[1]):
            if (j-2) %5 == 0:  # obj_n is at indexes 2,7,12,... (j starts from 0)
                # For obj type (integer), use 0 padding, so mask where value >0 is valid
                mask[:, j] = (X_flat[:, j] > 0)
            else:
                # Other features: valid where non-zero (pad with 0)
                mask[:, j] = (X_flat[:, j] !=0)
        # Calculate medians (ignore padded zeros)
        medians = []
        for j in range(X_flat.shape[1]):
            if j ==0 or j==1:  # E_T_miss and phi
                valid = X_flat[:, j][mask[:, j]]
            else:
                # Skip object type columns (j=2,7,12...)
                if (j-2) %5 ==0:
                    medians.append(0)  # object type won't be normalized
                    continue
                valid = X_flat[:, j][mask[:, j]]
            if len(valid) ==0:
                med = 0.0
            else:
                med = valid.median().item()
            medians.append(med)
        self.medians = torch.tensor(medians, dtype=X.dtype)
        self.has_fit = True
        return self

    def transform(self, X):
        # Apply robust scaling: (x - median) / IQR, but using median for centering
        # Also, normalize E_T_miss and per-object pT by log(1 + x)
        X_new = X.clone()
        # Handle E_T_miss (index 0)
        X_new[:, 0] = torch.log1p(X_new[:, 0] / 1e3)  # Convert MeV to GeV and log
        # phi_Et_miss (angular, index 1) is kept as is

        # For each object's features
        for obj_idx in range(18):
            start_col = 2 + obj_idx *5
            # obj_type = X_new[:, start_col] (integer)
            E_col = start_col +1
            pT_col = start_col +2
            eta_col = start_col +3
            phi_col = start_col +4

            # Log-scale pT (convert MeV to GeV)
            X_new[:, pT_col] = torch.log1p(X_new[:, pT_col] / 1e3)
            # Eta: normalize by dividing by 5 (approximate max |eta| ~5 in LHC)
            X_new[:, eta_col] = X_new[:, eta_col] / 5.0
            # Phi: already in [-pi, pi], normalize to [-1,1]
            X_new[:, phi_col] = X_new[:, phi_col] / np.pi

        # Apply median normalization for non-object-type features
        for j in range(X_new.shape[1]):
            if j in [0,1]:  # Already processed global features
                continue
            if (j-2)%5 ==0:  # Object type, keep as integer (no scaling)
                continue
            med = self.medians[j]
            if med >0:  # Avoid division by zero
                X_new[:, j] = (X_new[:, j] - med) / (med + self.eps)
        # Create mask for objects (obj_type >0)
        mask = (X_new[:, 2::5] > 0).float()  # shape: (batch, max_objects)
        return (X_new, mask)

    def fit_transform(self, X, y=None):
        self.fit(X, y)
        return self.transform(X)

def make_preprocessor():
    return MyPreprocessor()

# 2. ---------- MODEL DEFINITION ----------
class ParticleTransformer(nn.Module):
    def __init__(self, input_dim, num_heads=8, hidden_dim=256, num_layers=4):
        super().__init__()
        self.embedding = nn.Linear(input_dim, hidden_dim)
        encoder_layer = nn.TransformerEncoderLayer(
            d_model=hidden_dim, nhead=num_heads, dim_feedforward=hidden_dim*4,
            dropout=0.1, activation='gelu', batch_first=True
        )
        self.transformer = nn.TransformerEncoder(encoder_layer, num_layers=num_layers)
        self.global_features = nn.Sequential(
            nn.Linear(2, hidden_dim//2),  # E_T_miss and phi features
            nn.GELU(),
            nn.Linear(hidden_dim//2, hidden_dim)
        )
        self.classifier = nn.Sequential(
            nn.Linear(hidden_dim*2, hidden_dim),
            nn.GELU(),
            nn.Dropout(0.3),
            nn.Linear(hidden_dim, 1)
        )

    def forward(self, x, mask):
        # x: (batch, 92), mask: (batch, 18)
        # Split into physics objects and global features
        global_feats = x[:, :2]  # E_T_miss and phi_Et_miss
        objects = x[:, 2:].view(x.size(0), 18, 5)  # (batch, 18 objs, 5 features each)
        # Extract features: obj_1 + E,pT,eta,phi (after preproc)
        # Remove obj_type (first of 5 features) since preprocessed mask handles presence
        obj_features = objects[:, :, 1:]  # shape: (batch, 18, 4)
        valid_objs = mask.unsqueeze(-1)  # (batch, 18, 1)
        # Project input features
        obj_emb = self.embedding(obj_features) * valid_objs
        # Transformer expects (batch, seq_len, dim)
        padding_mask = (~mask.bool())  # True where padding
        obj_out = self.transformer(obj_emb, src_key_padding_mask=padding_mask)
        # Mean pooling over objects (masked)
        obj_pooled = torch.sum(obj_out * valid_objs, dim=1) / (torch.sum(valid_objs, dim=1) + 1e-8)
        # Process global features
        global_emb = self.global_features(global_feats)
        # Combine object and global
        combined = torch.cat([obj_pooled, global_emb], dim=1)
        logit = self.classifier(combined).squeeze(-1)
        return logit

def make_model(input_shape, *, use_mask=False):
    model = ParticleTransformer(input_dim=4)  # 4 features per object after excluding obj_type
    return model

# 3. ---------- MODEL TRAINING ----------
EPOCHS = 50
class WeightedBCEWithLogitsLoss(nn.Module):
    def __init__(self, weights=None):
        super().__init__()
        self.weights = weights  # [weight for class 0, class1]

    def forward(self, logits, targets):
        if self.weights is None:
            return F.binary_cross_entropy_with_logits(logits, targets.float())
        weights = targets * self.weights[1] + (1 - targets) * self.weights[0]
        return F.binary_cross_entropy_with_logits(logits, targets.float(), weight=weights)

class PhysicsDataset(Dataset):
    def __init__(self, X, y, preprocessor):
        self.preprocessor = preprocessor
        self.X = X
        self.y = y

    def __len__(self):
        return len(self.X)

    def __getitem__(self, idx):
        x = self.X[idx]
        y = self.y[idx]
        x_proc, mask = self.preprocessor.transform(x.unsqueeze(0))  # add batch dim
        return (x_proc.squeeze(0), mask.squeeze(0)), y

def train_model(model, train_loader, val_loader, epochs):
    device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')
    model.to(device)
    optimizer = torch.optim.AdamW(model.parameters(), lr=5e-4, weight_decay=1e-5)
    # Class weights for BCE (assuming Y_train has ~50% signal)
    # Since balanced, maybe no need, but keep for flexibility
    weight_class1 = torch.sum(Y_train ==0).float() / len(Y_train)
    weight_class0 = torch.sum(Y_train ==1).float() / len(Y_train)
    criterion = WeightedBCEWithLogitsLoss(weights=[weight_class0, weight_class1])
    scheduler = ReduceLROnPlateau(optimizer, 'max', patience=3, factor=0.5, verbose=False)

    best_auc = 0.0
    best_weights = None
    train_loss = []
    val_loss = []
    train_acc = []
    val_acc = []

    for epoch in range(epochs):
        model.train()
        epoch_train_loss = 0
        correct_train = 0
        total_train = 0
        for (x, mask), y in train_loader:
            x = x.to(device)
            mask = mask.to(device)
            y = y.to(device).float()
            optimizer.zero_grad()
            logits = model(x, mask)
            preds = torch.sigmoid(logits)
            loss = criterion(logits, y)
            loss.backward()
            optimizer.step()
            epoch_train_loss += loss.item() * x.size(0)
            pred_labels = (preds >= 0.5).long()
            correct_train += (pred_labels == y.long()).sum().item()
            total_train += y.size(0)

        train_loss.append(epoch_train_loss / total_train)
        train_acc.append(correct_train / total_train)

        model.eval()
        epoch_val_loss = 0
        correct_val = 0
        total_val = 0
        y_true = []
        y_score = []
        with torch.no_grad():
            for (x, mask), y in val_loader:
                x = x.to(device)
                mask = mask.to(device)
                y = y.to(device).float()
                logits = model(x, mask)
                preds = torch.sigmoid(logits)
                loss = criterion(logits, y)
                epoch_val_loss += loss.item() * x.size(0)
                pred_labels = (preds >=0.5).long()
                correct_val += (pred_labels == y.long()).sum().item()
                total_val += y.size(0)
                y_true.append(y.cpu())
                y_score.append(preds.cpu())

        val_loss.append(epoch_val_loss / total_val)
        val_acc.append(correct_val / total_val)
        y_true = torch.cat(y_true).numpy()
        y_score = torch.cat(y_score).numpy()
        auc = roc_auc_score(y_true, y_score)
        scheduler.step(auc)

        if auc > best_auc:
            best_auc = auc
            best_weights = model.state_dict().copy()

        if epoch - np.argmax([auc]*(epoch+1)) >=7:
            print(f"Early stopping at epoch {epoch}")
            break

    model.load_state_dict(best_weights)
    return model, train_loss, val_loss, train_acc, val_acc
