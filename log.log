"language": "Python",
"code": "# Imports: torch, numpy, pandas, matplotlib, sklearn are already available
# via the wrapper. Only import extra std-lib modules or torch.nn sub-modules
# you actually use.
import torch
import torch.nn as nn
import torch.optim as optim
import numpy as np
from sklearn.preprocessing import StandardScaler
from sklearn.metrics import roc_auc_score
from collections import defaultdict

class EventPreprocessor:
    def __init__(self):
        self.scaler = StandardScaler()
        self.n_objects = 18  # Maximum number of objects in the dataset
        self.object_features = 5  # Features per object (obj_id, E, p_T, eta, phi)
        
    def fit(self, X, y=None):
        # Extract valid features and compute summary statistics
        processed_features = self._extract_features(X)
        self.scaler.fit(processed_features)
        return self
    
    def transform(self, X):
        processed_features = self._extract_features(X)
        scaled_features = self.scaler.transform(processed_features)
        return torch.tensor(scaled_features, dtype=torch.float32)
    
    def _extract_features(self, X):
        # Handle X as numpy array or torch tensor
        if isinstance(X, torch.Tensor):
            X = X.numpy()
        
        batch_size = X.shape[0]
        features = []
        
        for i in range(batch_size):
            event = X[i]
            
            # Extract missing energy features
            et_miss = event[0]
            phi_et_miss = event[1]
            
            # Initialize counters and accumulators
            n_jets = 0
            n_electrons = 0
            n_muons = 0
            
            total_pt = 0
            total_energy = 0
            
            jet_pts = []
            lepton_pts = []
            
            # Objects start at index 2 and each object has 5 features
            for obj_idx in range(18):
                start_idx = 2 + obj_idx * self.object_features
                
                # Check if object exists (nonzero ID)
                obj_id = event[start_idx]
                if obj_id == 0:
                    continue
                
                E = event[start_idx + 1]
                pt = event[start_idx + 2]
                eta = event[start_idx + 3]
                phi = event[start_idx + 4]
                
                # Skip if key kinematics are zero (padding)
                if E == 0 and pt == 0:
                    continue
                
                # Count object types (1=electron, 2=muon, 3=jet)
                if obj_id == 1:
                    n_electrons += 1
                    lepton_pts.append(pt)
                elif obj_id == 2:
                    n_muons += 1
                    lepton_pts.append(pt)
                elif obj_id == 3:
                    n_jets += 1
                    jet_pts.append(pt)
                
                total_pt += pt
                total_energy += E
            
            # Sort pt values in descending order
            jet_pts.sort(reverse=True)
            lepton_pts.sort(reverse=True)
            
            # Basic features
            event_features = [
                et_miss,
                phi_et_miss,
                n_jets,
                n_electrons,
                n_muons,
                total_pt,
                total_energy,
                et_miss / (total_pt + 1e-8),  # MET significance
            ]
            
            # Add leading jet pTs (pad if necessary)
            leading_jets = jet_pts[:4] + [0] * max(0, 4 - len(jet_pts))
            event_features.extend(leading_jets)
            
            # Add leading lepton pTs (pad if necessary)
            leading_leptons = lepton_pts[:2] + [0] * max(0, 2 - len(lepton_pts))
            event_features.extend(leading_leptons)
            
            # Calculate HT (scalar sum of jet pT)
            HT = sum(jet_pts)
            event_features.append(HT)
            
            # Add jet multiplicity features
            n_bjets = min(n_jets, 4)  # Approximation of b-jets
            event_features.append(n_bjets)
            
            features.append(event_features)
            
        return np.array(features)

def make_preprocessor():
    preproc = EventPreprocessor()
    return preproc

class AttentionBlock(nn.Module):
    def __init__(self, input_dim, hidden_dim):
        super().__init__()
        self.attention = nn.Sequential(
            nn.Linear(input_dim, hidden_dim),
            nn.ReLU(),
            nn.Linear(hidden_dim, 1)
        )
        
    def forward(self, x):
        # x shape: (batch_size, input_dim)
        weights = torch.softmax(self.attention(x), dim=0)
        return weights * x

class FourTopClassifier(nn.Module):
    def __init__(self, input_dim):
        super(FourTopClassifier, self).__init__()
        
        # Define dimensions
        hidden_dim1 = 128
        hidden_dim2 = 64
        hidden_dim3 = 32
        dropout_rate = 0.3
        
        # Feature extraction layers
        self.feature_layers = nn.Sequential(
            nn.Linear(input_dim, hidden_dim1),
            nn.BatchNorm1d(hidden_dim1),
            nn.ReLU(),
            nn.Dropout(dropout_rate),
            
            nn.Linear(hidden_dim1, hidden_dim2),
            nn.BatchNorm1d(hidden_dim2),
            nn.ReLU(),
            nn.Dropout(dropout_rate),
        )
        
        # Attention mechanism
        self.attention = AttentionBlock(hidden_dim2, hidden_dim3)
        
        # Classification head
        self.classifier = nn.Sequential(
            nn.Linear(hidden_dim2, hidden_dim3),
            nn.ReLU(),
            nn.Dropout(dropout_rate),
            nn.Linear(hidden_dim3, 1),
        )
        
    def forward(self, x):
        features = self.feature_layers(x)
        attended = self.attention(features)
        logits = self.classifier(attended).squeeze(-1)
        return logits

def make_model(input_dim: int):
    model = FourTopClassifier(input_dim)
    return model

EPOCHS = 30

def train_model(model: nn.Module,
                train_loader: torch.utils.data.DataLoader,
                val_loader: torch.utils.data.DataLoader,
                epochs: int):
    
    # Initialize optimizer and loss function
    optimizer = optim.Adam(model.parameters(), lr=0.001, weight_decay=1e-4)
    criterion = nn.BCEWithLogitsLoss()
    
    # Learning rate scheduler
    scheduler = optim.lr_scheduler.ReduceLROnPlateau(
        optimizer, mode='max', factor=0.5, patience=3, verbose=True
    )
    
    # Initialize tracking lists
    train_loss = []
    val_loss = []
    train_acc = []
    val_acc = []
    best_val_auc = 0
    best_model_state = None
    
    for epoch in range(epochs):
        # Training phase
        model.train()
        epoch_train_loss = 0
        epoch_train_correct = 0
        epoch_train_total = 0
        train_outputs = []
        train_targets = []
        
        for inputs, targets in train_loader:
            optimizer.zero_grad()
            outputs = model(inputs)
            loss = criterion(outputs, targets.float())
            
            # Backward and optimize
            loss.backward()
            optimizer.step()
            
            # Track metrics
            epoch_train_loss += loss.item() * inputs.size(0)
            preds = (torch.sigmoid(outputs) > 0.5).float()
            epoch_train_correct += (preds == targets).sum().item()
            epoch_train_total += targets.size(0)
            
            # Store for AUC calculation
            train_outputs.append(torch.sigmoid(outputs).detach().cpu().numpy())
            train_targets.append(targets.cpu().numpy())
        
        # Compute epoch metrics
        epoch_train_loss /= epoch_train_total
        epoch_train_acc = epoch_train_correct / epoch_train_total
        train_loss.append(epoch_train_loss)
        train_acc.append(epoch_train_acc)
        
        # Calculate train AUC
        train_outputs = np.concatenate(train_outputs)
        train_targets = np.concatenate(train_targets)
        train_auc = roc_auc_score(train_targets, train_outputs)
        
        # Validation phase
        model.eval()
        epoch_val_loss = 0
        epoch_val_correct = 0
        epoch_val_total = 0
        val_outputs = []
        val_targets = []
        
        with torch.no_grad():
            for inputs, targets in val_loader:
                outputs = model(inputs)
                loss = criterion(outputs, targets.float())
                
                # Track metrics
                epoch_val_loss += loss.item() * inputs.size(0)
                preds = (torch.sigmoid(outputs) > 0.5).float()
                epoch_val_correct += (preds == targets).sum().item()
                epoch_val_total += targets.size(0)
                
                # Store for AUC calculation
                val_outputs.append(torch.sigmoid(outputs).detach().cpu().numpy())
                val_targets.append(targets.cpu().numpy())
        
        # Compute epoch metrics
        epoch_val_loss /= epoch_val_total
        epoch_val_acc = epoch_val_correct / epoch_val_total
        val_loss.append(epoch_val_loss)
        val_acc.append(epoch_val_acc)
        
        # Calculate validation AUC
        val_outputs = np.concatenate(val_outputs)
        val_targets = np.concatenate(val_targets)
        val_auc = roc_auc_score(val_targets, val_outputs)
        
        # Update learning rate based on validation AUC
        scheduler.step(val_auc)
        
        # Save best model
        if val_auc > best_val_auc:
            best_val_auc = val_auc
            best_model_state = model.state_dict().copy()
        
        # Print epoch results
        print(f'Epoch {epoch+1}/{epochs}:')
        print(f'Train - Loss: {epoch_train_loss:.4f}, Acc: {epoch_train_acc:.4f}, AUC: {train_auc:.4f}')
        print(f'Val   - Loss: {epoch_val_loss:.4f}, Acc: {epoch_val_acc:.4f}, AUC: {val_auc:.4f}')
    
    # Load best model
    if best_model_state is not None:
        model.load_state_dict(best_model_state)
    
    return model, train_loss, val_loss, train_acc, val_acc",
"explanation": "This code implements a machine learning solution for classifying four top quark events in high-energy particle physics collisions. Let me explain the key components:

1. **Data Preprocessing (EventPreprocessor)**:
   - The preprocessor extracts meaningful physics features from the raw event data
   - It counts the different types of particles (electrons, muons, jets)
   - It calculates important physics quantities like:
     - Total transverse momentum (pT) and energy
     - Missing transverse energy (MET) and its significance
     - Leading jet and lepton momenta
     - HT (scalar sum of jet pT)
   - Data standardization using StandardScaler to normalize feature scales

2. **Model Architecture (FourTopClassifier)**:
   - A neural network with multiple fully connected layers
   - BatchNormalization and Dropout for regularization to prevent overfitting
   - An attention mechanism that helps the model focus on the most relevant features
   - The final output is a single logit which is passed through a sigmoid for binary classification

3. **Training Procedure**:
   - Uses BCEWithLogitsLoss (Binary Cross-Entropy with Logits) as the loss function
   - Adam optimizer with weight decay for regularization
   - ReduceLROnPlateau scheduler to adjust learning rate when validation performance plateaus
   - Model selection based on best validation AUC (our target metric)
   - Detailed tracking of training and validation metrics including accuracy and AUC

4. **Physics-Informed Feature Engineering**:
   - The features extracted are specifically chosen based on particle physics knowledge
   - Differentiation between object types (electrons, muons, jets) which have different behaviors
   - Inclusion of derived quantities that are known to be discriminative for top quark events:
     - Jet multiplicity (four top events have many jets)
     - MET significance (ratio of missing energy to total visible energy)
     - Leading particle pT values (ordered by momentum)

The approach balances model complexity with efficiency, focusing on extracting the most relevant physics information without creating an overly complex model that might overfit. The attention mechanism helps the model learn which features are most important for this specific classification task."
