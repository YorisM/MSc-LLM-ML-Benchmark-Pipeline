"code": "# 0. ---------- IMPORTS ----------\nimport torch\nimport numpy as np\nfrom torch import nn\nfrom torch.utils.data import TensorDataset, DataLoader\nimport torch.nn.functional as F\nfrom torch.optim import Adam\nfrom sklearn.metrics import roc_auc_score\nimport math\n\n# 1. ---------- PRE-PROCESSING ----------\nclass MyPreprocessor:\n    def __init__(self):\n        self.means = None\n        self.stds = None\n        self.epsilon = 1e-8\n        \n    def fit(self, X, y=None):\n        # Extract valid features (non-zero and non-padded)\n        # Missing ET values are always at indices 0 and 1\n        # The rest are objects with 5 values each (obj_id, E, pT, eta, phi)\n        \n        # Create mask for valid objects (where obj_id != 0)\n        valid_mask = self.create_valid_mask(X)  # Shape: [N, 18]\n        \n        # Extract features for normalization - we'll normalize only E and pT\n        # We'll collect all valid E and pT values across the dataset\n        all_E_values = []\n        all_pT_values = []\n        all_ET_miss_values = []\n        \n        for i in range(X.shape[0]):\n            # Missing ET\n            all_ET_miss_values.append(X[i, 0].item())\n            \n            # For each object\n            for j in range(18):  # 18 possible objects\n                if valid_mask[i, j]:  # If this is a valid object\n                    obj_start = 2 + j * 5  # Starting index of this object\n                    all_E_values.append(X[i, obj_start + 1].item())  # E value\n                    all_pT_values.append(X[i, obj_start + 2].item())  # pT value\n        \n        # Convert to tensors and compute statistics\n        all_E_values = torch.tensor(all_E_values)\n        all_pT_values = torch.tensor(all_pT_values)\n        all_ET_miss_values = torch.tensor(all_ET_miss_values)\n        \n        # Compute mean and std for normalization\n        self.E_mean = all_E_values.mean().item()\n        self.E_std = all_E_values.std().item()\n        \n        self.pT_mean = all_pT_values.mean().item()\n        self.pT_std = all_pT_values.std().item()\n        \n        self.ET_miss_mean = all_ET_miss_values.mean().item()\n        self.ET_miss_std = all_ET_miss_values.std().item()\n        \n        return self\n    \n    def create_valid_mask(self, X):\n        # Create a mask for valid objects (where obj_id != 0)\n        valid_mask = torch.zeros(X.shape[0], 18, dtype=torch.bool)\n        \n        for i in range(18):  # 18 possible objects\n            obj_id_index = 2 + i * 5  # Index of obj_id for this object\n            valid_mask[:, i] = X[:, obj_id_index] != 0  # Object exists if ID is not 0\n            \n        return valid_mask\n    \n    def transform(self, X):\n        # Create a new tensor to store the processed features\n        batch_size = X.shape[0]\n        \n        # Create mask for valid objects\n        valid_mask = self.create_valid_mask(X)  # Shape: [N, 18]\n        \n        # Normalize missing ET and phi\n        ET_miss_normalized = (X[:, 0] - self.ET_miss_mean) / (self.ET_miss_std + self.epsilon)\n        phi_ET_miss = X[:, 1]  # No normalization for angles\n        \n        # Create features for each object\n        # For each object, we'll extract (E, pT, eta, phi) and normalize E and pT\n        object_features = []\n        \n        for i in range(18):  # 18 possible objects\n            obj_start = 2 + i * 5  # Starting index of object in the flat tensor\n            \n            # Extract and normalize features\n            mask = valid_mask[:, i].unsqueeze(1)  # Shape: [N, 1]\n            \n            # Extract features for this object\n            obj_id = X[:, obj_start].unsqueeze(1)  # Shape: [N, 1]\n            E = X[:, obj_start + 1].unsqueeze(1)  # Shape: [N, 1]\n            pT = X[:, obj_start + 2].unsqueeze(1)  # Shape: [N, 1]\n            eta = X[:, obj_start + 3].unsqueeze(1)  # Shape: [N, 1]\n            phi = X[:, obj_start + 4].unsqueeze(1)  # Shape: [N, 1]\n            \n            # Normalize E and pT\n            E_norm = (E - self.E_mean) / (self.E_std + self.epsilon)\n            pT_norm = (pT - self.pT_mean) / (self.pT_std + self.epsilon)\n            \n            # Create a tensor with all features for this object\n            # We include the original object ID for possible particle type identification\n            obj_features = torch.cat([obj_id, E_norm, pT_norm, eta, phi], dim=1)  # Shape: [N, 5]\n            \n            # Apply mask to zero out invalid objects\n            # Expand mask to match feature dimension\n            mask_expanded = mask.expand(-1, 5)  # Shape: [N, 5]\n            obj_features = obj_features * mask_expanded  # Zero out invalid objects\n            \n            object_features.append(obj_features)\n        \n        # Combine all object features\n        objects_tensor = torch.stack(object_features, dim=1)  # Shape: [N, 18, 5]\n        \n        # Add missing ET features as a separate channel\n        ET_features = torch.stack([ET_miss_normalized, phi_ET_miss], dim=1).unsqueeze(1)  # Shape: [N, 1, 2]\n        \n        # Final output: separate objects tensor and missing ET features\n        # This facilitates specialized processing in the model\n        return {\"objects\": objects_tensor, \"ET_miss\": ET_features, \"valid_mask\": valid_mask}\n        \n    def fit_transform(self, X, y=None):\n        self.fit(X, y)\n        return self.transform(X)\n\ndef make_preprocessor():\n    return MyPreprocessor()\n\n# 2. ---------- MODEL DEFINITION ----------\nclass LorentzEquivariantLayer(nn.Module):\n    def __init__(self, in_features, out_features):\n        super().__init__()\n        self.linear = nn.Linear(in_features, out_features)\n        \n    def forward(self, x):\n        # x shape: [batch_size, num_objects, features]\n        return self.linear(x)\n\nclass ParticleEmbedding(nn.Module):\n    def __init__(self, input_dim, embedding_dim):\n        super().__init__()\n        self.embedding = nn.Linear(input_dim, embedding_dim)\n        self.activation = nn.ELU()\n        \n    def forward(self, x):\n        # x shape: [batch_size, num_objects, features]\n        return self.activation(self.embedding(x))\n\nclass LorenzInnerProduct(nn.Module):\n    def __init__(self):\n        super().__init__()\n        # Minkowski metric tensor for Lorentz inner product: diag(1, -1, -1, -1)\n        self.minkowski_metric = torch.tensor([1.0, -1.0, -1.0, -1.0])\n        \n    def forward(self, p1, p2):\n        # Convert from (E, pT, eta, phi) to (E, px, py, pz)\n        p1_lorentz = self.to_lorentz_vector(p1)\n        p2_lorentz = self.to_lorentz_vector(p2)\n        \n        # Apply Minkowski metric for Lorentz inner product\n        metric = self.minkowski_metric.to(p1.device)\n        inner_product = (p1_lorentz * p2_lorentz * metric.unsqueeze(0).unsqueeze(0)).sum(dim=-1)\n        \n        return inner_product\n    \n    def to_lorentz_vector(self, p):\n        # p is assumed to be (E, pT, eta, phi) for each particle\n        # We convert to (E, px, py, pz)\n        E = p[..., 0]\n        pT = p[..., 1]\n        eta = p[..., 2]\n        phi = p[..., 3]\n        \n        # Convert to px, py, pz\n        px = pT * torch.cos(phi)\n        py = pT * torch.sin(phi)\n        pz = pT * torch.sinh(eta)  # pz = pT * sinh(\u03b7)\n        \n        return torch.stack([E, px, py, pz], dim=-1)\n\nclass InteractionNetwork(nn.Module):\n    def __init__(self, node_dim, edge_dim, hidden_dim):\n        super().__init__()\n        \n        # Edge model: takes a pair of nodes and their features and produces edge features\n        self.edge_model = nn.Sequential(\n            nn.Linear(2 * node_dim + 1, hidden_dim),  # +1 for the Lorentz inner product\n            nn.ELU(),\n            nn.Linear(hidden_dim, edge_dim),\n            nn.ELU()\n        )\n        \n        # Node model: updates node features based on aggregated edge features\n        self.node_model = nn.Sequential(\n            nn.Linear(node_dim + edge_dim, hidden_dim),\n            nn.ELU(),\n            nn.Linear(hidden_dim, node_dim),\n            nn.ELU()\n        )\n        \n        # Lorentz inner product layer\n        self.lorentz_product = LorenzInnerProduct()\n    \n    def forward(self, x, mask=None):\n        # x shape: [batch_size, num_objects, node_dim]\n        # mask shape: [batch_size, num_objects] - boolean mask of valid objects\n        \n        batch_size, num_objects, node_dim = x.shape\n        \n        # Compute all pairwise interactions\n        # First 4 features of node features are assumed to be (E, pT, eta, phi)\n        # Create pairwise tensor\n        x_i = x.unsqueeze(2).expand(batch_size, num_objects, num_objects, node_dim)\n        x_j = x.unsqueeze(1).expand(batch_size, num_objects, num_objects, node_dim)\n        \n        # Compute Lorentz inner products between all pairs\n        lorentz_products = self.lorentz_product(x_i[:,:,:,:4], x_j[:,:,:,:4])  # [batch_size, num_objects, num_objects]\n        lorentz_products = lorentz_products.unsqueeze(-1)  # Add feature dimension\n        \n        # Concatenate node pairs with their Lorentz inner product\n        edge_input = torch.cat([x_i, x_j, lorentz_products], dim=-1)  # [batch_size, num_objects, num_objects, 2*node_dim+1]\n        \n        # Process all edges\n        edge_features = self.edge_model(edge_input)  # [batch_size, num_objects, num_objects, edge_dim]\n        \n        # Apply mask if provided to ignore interactions with padding\n        if mask is not None:\n            # Create pairwise mask\n            mask_i = mask.unsqueeze(2).expand(batch_size, num_objects, num_objects)\n            mask_j = mask.unsqueeze(1).expand(batch_size, num_objects, num_objects)\n            edge_mask = (mask_i & mask_j).unsqueeze(-1)  # [batch_size, num_objects, num_objects, 1]\n            \n            # Apply mask to edge features\n            edge_features = edge_features * edge_mask.float()\n        \n        # Aggregate edge features for each node (sum over neighbors)\n        aggregated_edges = edge_features.sum(dim=2)  # [batch_size, num_objects, edge_dim]\n        \n        # Update node features\n        node_input = torch.cat([x, aggregated_edges], dim=-1)  # [batch_size, num_objects, node_dim+edge_dim]\n        updated_nodes = self.node_model(node_input)  # [batch_size, num_objects, node_dim]\n        \n        # Apply node mask if provided\n        if mask is not None:\n            node_mask = mask.unsqueeze(-1).expand(batch_size, num_objects, node_dim)  # [batch_size, num_objects, node_dim]\n            updated_nodes = updated_nodes * node_mask.float()\n        \n        # Residual connection\n        x = x + updated_nodes\n        \n        return x\n\nclass FourTopClassifier(nn.Module):\n    def __init__(self, input_dim):\n        super().__init__()\n        \n        # Dimensions\n        self.object_feat_dim = 5  # obj_id, E, pT, eta, phi\n        self.et_miss_feat_dim = 2  # ET_miss, phi_ET_miss\n        self.node_embedding_dim = 32\n        self.edge_dim = 32\n        self.hidden_dim = 64\n        \n        # Particle embedding layer\n        self.particle_embedding = ParticleEmbedding(self.object_feat_dim, self.node_embedding_dim)\n        \n        # ET_miss embedding\n        self.et_miss_embedding = nn.Sequential(\n            nn.Linear(self.et_miss_feat_dim, 16),\n            nn.ELU()\n        )\n        \n        # Message passing layers\n        self.interaction_layers = nn.ModuleList([\n            InteractionNetwork(self.node_embedding_dim, self.edge_dim, self.hidden_dim) \n            for _ in range(3)  # 3 interaction layers\n        ])\n        \n        # Global pooling -> classification\n        self.classifier = nn.Sequential(\n            nn.Linear(self.node_embedding_dim + 16, self.hidden_dim),  # +16 for ET_miss features\n            nn.ELU(),\n            nn.Dropout(0.2),\n            nn.Linear(self.hidden_dim, self.hidden_dim // 2),\n            nn.ELU(),\n            nn.Dropout(0.1),\n            nn.Linear(self.hidden_dim // 2, 1)\n        )\n    \n    def forward(self, x):\n        # x is a dict containing 'objects', 'ET_miss', and 'valid_mask'\n        objects = x['objects']  # [batch_size, num_objects, 5]\n        et_miss = x['ET_miss']  # [batch_size, 1, 2]\n        mask = x['valid_mask']  # [batch_size, num_objects]\n        \n        batch_size = objects.shape[0]\n        \n        # Embed particles\n        object_features = self.particle_embedding(objects)  # [batch_size, num_objects, node_embedding_dim]\n        \n        # Apply interaction networks with masking\n        for layer in self.interaction_layers:\n            object_features = layer(object_features, mask)\n        \n        # Global pooling over valid objects\n        if mask is not None:\n            # Sum over valid objects\n            count = mask.sum(dim=1, keepdim=True)  # [batch_size, 1]\n            count = torch.clamp(count, min=1)  # Avoid division by zero\n            \n            # Apply mask and compute mean\n            masked_features = object_features * mask.unsqueeze(-1).float()  # [batch_size, num_objects, node_embedding_dim]\n            global_features = masked_features.sum(dim=1) / count  # [batch_size, node_embedding_dim]\n        else:\n            # If no mask, just average over all objects\n            global_features = object_features.mean(dim=1)  # [batch_size, node_embedding_dim]\n        \n        # Process ET_miss and concatenate with global features\n        et_miss_features = self.et_miss_embedding(et_miss.squeeze(1))  # [batch_size, 16]\n        combined_features = torch.cat([global_features, et_miss_features], dim=1)  # [batch_size, node_embedding_dim+16]\n        \n        # Final classification\n        logits = self.classifier(combined_features).squeeze(-1)  # [batch_size]\n        \n        return logits\n\ndef make_model(input_dim: int):\n    model = FourTopClassifier(input_dim)\n    return model\n\n# 3. ---------- MODEL TRAINING ----------\nEPOCHS = 20\n\ndef train_model(model, train_loader, val_loader, epochs):\n    device = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n    model = model.to(device)\n    \n    # Loss function and optimizer\n    criterion = nn.BCEWithLogitsLoss()\n    optimizer = Adam(model.parameters(), lr=0.001, weight_decay=1e-4)\n    scheduler = torch.optim.lr_scheduler.ReduceLROnPlateau(\n        optimizer, mode='max', factor=0.5, patience=2, threshold=0.001, \n        min_lr=1e-5, threshold_mode='rel'\n    )\n    \n    # Lists to store metrics\n    train_losses, val_losses = [], []\n    train_accs, val_accs = [], []\n    best_auc = 0.0\n    \n    for epoch in range(epochs):\n        # Training phase\n        model.train()\n        train_loss = 0.0\n        train_correct = 0\n        train_total = 0\n        train_preds, train_targets = [], []\n        \n        for inputs, targets in train_loader:\n            inputs = {k: v.to(device) for k, v in inputs.items()} if isinstance(inputs, dict) else inputs.to(device)\n            targets = targets.to(device).float()\n            \n            # Forward pass\n            optimizer.zero_grad()\n            outputs = model(inputs)\n            loss = criterion(outputs, targets)\n            \n            # Backward pass and optimize\n            loss.backward()\n            optimizer.step()\n            \n            # Track metrics\n            train_loss += loss.item() * targets.size(0)\n            preds = torch.sigmoid(outputs) > 0.5\n            train_correct += (preds == targets).sum().item()\n            train_total += targets.size(0)\n            \n            # Store predictions and targets for AUC calculation\n            train_preds.extend(torch.sigmoid(outputs).detach().cpu().numpy())\n            train_targets.extend(targets.cpu().numpy())\n        \n        # Calculate epoch metrics\n        train_loss /= train_total\n        train_acc = train_correct / train_total\n        train_auc = roc_auc_score(train_targets, train_preds)\n        \n        # Validation phase\n        model.eval()\n        val_loss = 0.0\n        val_correct = 0\n        val_total = 0\n        val_preds, val_targets = [], []\n        \n        with torch.no_grad():\n            for inputs, targets in val_loader:\n                inputs = {k: v.to(device) for k, v in inputs.items()} if isinstance(inputs, dict) else inputs.to(device)\n                targets = targets.to(device).float()\n                \n                # Forward pass\n                outputs = model(inputs)\n                loss = criterion(outputs, targets)\n                \n                # Track metrics\n                val_loss += loss.item() * targets.size(0)\n                preds = torch.sigmoid(outputs) > 0.5\n                val_correct += (preds == targets).sum().item()\n                val_total += targets.size(0)\n                \n                # Store predictions and targets for AUC calculation\n                val_preds.extend(torch.sigmoid(outputs).detach().cpu().numpy())\n                val_targets.extend(targets.cpu().numpy())\n        \n        # Calculate epoch metrics\n        val_loss /= val_total\n        val_acc = val_correct / val_total\n        val_auc = roc_auc_score(val_targets, val_preds)\n        \n        # Update learning rate based on validation AUC\n        scheduler.step(val_auc)\n        \n        # Save metrics\n        train_losses.append(train_loss)\n        val_losses.append(val_loss)\n        train_accs.append(train_acc)\n        val_accs.append(val_acc)\n        \n        # Print metrics\n        print(f'Epoch {epoch+1}/{epochs}:')\n        print(f'Train Loss: {train_loss:.4f}, Train Acc: {train_acc:.4f}, Train AUC: {train_auc:.4f}')\n        print(f'Val Loss: {val_loss:.4f}, Val Acc: {val_acc:.4f}, Val AUC: {val_auc:.4f}')\n        \n        # Save best model\n        if val_auc > best_auc:\n            best_auc = val_auc\n            best_model_state = {k: v.to('cpu').clone() for k, v in model.state_dict().items()}\n    \n    # Load best model\n    model.load_state_dict(best_model_state)\n    model = model.to(device)\n    \n    return model, train_losses, val_losses, train_accs, val_accs",
"explanation": "This code implements a deep learning model for classifying four-top-quark events from background processes in particle physics. Here's a detailed explanation of the approach:

1. **Preprocessing (MyPreprocessor class):**
   - Extracts valid objects by creating a mask where object IDs are non-zero
   - Normalizes energy (E) and transverse momentum (pT) features using dataset statistics
   - Preserves angular variables (eta, phi) without normalization since they're already bounded
   - Returns a dictionary with organized tensors: objects features, missing transverse energy, and validity masks

2. **Model Architecture:**
   - **LorentzEquivariantLayer:** Implements a basic equivariant transformation for particle features
   - **ParticleEmbedding:** Maps raw particle features to a higher-dimensional representation
   - **LorenzInnerProduct:** Computes Lorentz-invariant products between four-vectors by transforming from (E, pT, eta, phi) to (E, px, py, pz) and applying the Minkowski metric
   - **InteractionNetwork:** Implements message passing between particles with explicit Lorentz invariance
     - Edge model: Processes pairs of particles using their features and Lorentz inner product
     - Node model: Updates particle features based on aggregated edge features
     - Maintains Lorentz invariance in the message-passing mechanism
   - **FourTopClassifier:** Main model architecture
     - Embeds particles and missing ET separately
     - Applies multiple interaction network layers for message passing
     - Performs global pooling over valid objects
     - Makes final classification with a multi-layer perceptron

3. **Training Procedure:**
   - Uses BCE with logits loss for binary classification
   - Implements Adam optimizer with weight decay to prevent overfitting
   - Uses a learning rate scheduler based on validation AUC
   - Tracks and reports training/validation loss, accuracy, and AUC
   - Implements early stopping by saving the best model based on validation AUC

4. **Physics-Informed Features:**
   - The model explicitly encodes Lorentz symmetry through:
     - Proper handling of four-vectors and their transformations
     - Using the Minkowski metric for inner products
     - Maintaining equivariance through message passing
   - The interaction network allows modeling interactions between particles, which is crucial for capturing the complex event topology of four-top events
   - Masking is used extensively to handle the variable number of particles per event

This approach combines deep learning with physics-informed inductive biases, ensuring that the model respects the underlying symmetries of the particle physics domain while efficiently learning from the data to maximize AUC performance."
}
