m_events = X_train.shape[0]\n\n    # Calculate means\n    mean_met = met_train.mean(dim=0)\n    mean_id = (ids_train.unsqueeze(-1) * mask_train_expanded_id).sum(dim=(0, 1)) / num_real_particles\n    mean_p4 = (p4_train * mask_train_expanded_p4).sum(dim=(0, 1)) / num_real_particles\n    means = torch.cat([mean_met, mean_id, mean_p4], dim=0)\n\n    # Calculate stds\n    std_met = met_train.std(dim=0)\n    std_id = torch.sqrt(((ids_train.unsqueeze(-1) - mean_id) ** 2 * mask_train_expanded_id).sum(dim=(0, 1)) / num_real_particles)\n    std_p4 = torch.sqrt(((p4_train - mean_p4) ** 2 * mask_train_expanded_p4).sum(dim=(0, 1)) / num_real_particles)\n    stds = torch.cat([std_met, std_id, std_p4], dim=0)\n\n    # Create and fit preprocessor\n    preproc = PreprocessModule(means, stds)\n\n    # Apply preprocessing\n    # The preprocessor now returns a tuple: (particle_features_norm, met_f_norm, mask)\n    X_train_p_tuple = preproc(X_train)\n    X_val_p_tuple = preproc(X_val)\n\n    # Create TensorDatasets from the tuples\n    train_ds = TensorDataset(X_train_p_tuple[0], X_train_p_tuple[1], X_train_p_tuple[2], Y_train)\n    val_ds = TensorDataset(X_val_p_tuple[0], X_val_p_tuple[1], X_val_p_tuple[2], Y_val)\n\n    train_loader = DataLoader(train_ds, batch_size=batch_size, shuffle=True)\n    val_loader = DataLoader(val_ds, batch_size=batch_size)\n\n    # The model will now receive batches like: particle_feats, met_feats, mask, label\n    # The input_dim for the classifier needs to be adapted based on how it uses these inputs.\n    return train_loader, val_loader, preproc\n\n# Helper function for Minkowski product\n_eta = torch.tensor([1., -1., -1., -1.])\ndef minkowski_dot(p1, p2):\n    # p1, p2 shapes: (..., 4)\n    if _eta.device != p1.device:\n       _eta.to(p1.device)\n    return torch.sum(p1 * p2 * _eta.to(p1.device), dim=-1)\n\n# ----- FREE SECTION: Binary Classifier Definition -----\nclass Classifier(nn.Module):\n    def __init__(self, particle_feat_dim=5, met_feat_dim=3, hidden_dim=64, n_layers=3, dropout_rate=0.1):\n        super(Classifier, self).__init__()\n\n        # Particle embedding MLP\n        self.particle_mlp = nn.Sequential(\n            nn.Linear(particle_feat_dim, hidden_dim),\n            nn.ReLU(),\n            nn.Linear(hidden_dim, hidden_dim),\n            nn.ReLU()\n        )\n\n        # Interaction layers (Simplified Lorentz-Equivariant Style)\n        self.interaction_layers = nn.ModuleList()\n        for _ in range(n_layers):\n            self.interaction_layers.append(InteractionLayer(hidden_dim, dropout_rate))\n\n        # MET embedding MLP\n        self.met_mlp = nn.Sequential(\n            nn.Linear(met_feat_dim, hidden_dim // 2),\n            nn.ReLU(),\n            nn.Linear(hidden_dim // 2, hidden_dim // 2)\n        )\n\n        # Final classifier MLP\n        self.final_mlp = nn.Sequential(\n            nn.Linear(hidden_dim + hidden_dim // 2, hidden_dim),\n            nn.ReLU(),\n            nn.Dropout(dropout_rate),\n            nn.Linear(hidden_dim, 1)\n        )\n\n    def forward(self, particle_features, met_features, mask):\n        # particle_features: (B, N, 5) - obj_id_norm, p4_norm[E, px, py, pz]\n        # met_features: (B, 3) - met_et_norm, met_x_norm, met_y_norm\n        # mask: (B, N)\n\n        # Embed particles\n        # Input to particle_mlp is (obj_id_norm, E_norm, px_norm, py_norm, pz_norm)\n        particle_embeddings = self.particle_mlp(particle_features) * mask.unsqueeze(-1) # (B, N, D_hid)\n\n        # Extract p4 for interactions (un-normalized or normalized? Use normalized for consistency)\n        p4_norm = particle_features[:, :, 1:] # Shape (B, N, 4)\n\n        # Apply interaction layers\n        current_embeddings = particle_embeddings\n        for layer in self.interaction_layers:\n            current_embeddings = layer(current_embeddings, p4_norm, mask)\n\n        # Aggregate particle information (masked mean pooling)\n        summed_embeddings = (current_embeddings * mask.unsqueeze(-1)).sum(dim=1) # (B, D_hid)\n        norm = mask.sum(dim=1, keepdim=True).clamp(min=1e-6) # (B, 1)\n        aggregated_embeddings = summed_embeddings / norm # (B, D_hid)\n\n        # Embed MET\n        met_embeddings = self.met_mlp(met_features) # (B, D_hid//2)\n\n        # Combine aggregated particle info and MET info\n        combined_features = torch.cat([aggregated_embeddings, met_embeddings], dim=1) # (B, D_hid + D_hid//2)\n\n        # Final classification\n        logits = self.final_mlp(combined_features) # (B, 1)\n        return logits.squeeze(-1) # Return (B,) for BCEWithLogitsLoss\n\nclass InteractionLayer(nn.Module):\n    def __init__(self, hidden_dim, dropout_rate):\n        super().__init__()\n        self.hidden_dim = hidden_dim\n        # MLPs for message calculation\n        self.mlp_msg = nn.Sequential(\n            nn.Linear(2 * hidden_dim + 1, hidden_dim), # feat_i, feat_j, minkowski_dot\n            nn.ReLU(),\n            nn.Dropout(dropout_rate),\n            nn.Linear(hidden_dim, hidden_dim)\n        )\n        # MLP for update\n        self.mlp_update = nn.Sequential(\n            nn.Linear(2 * hidden_dim, hidden_dim), # feat_i, aggregated_message\n            nn.ReLU()\n        )\n        self.norm = nn.LayerNorm(hidden_dim)\n\n    def forward(self, h, p4, mask):\n        # h: particle embeddings (B, N, D_hid)\n        # p4: particle 4-vectors (B, N, 4)\n        # mask: (B, N)\n        B, N, D_hid = h.shape\n\n        # Expand features for pairwise comparison\n        h_i = h.unsqueeze(2).expand(-1, -1, N, -1) # (B, N, N, D_hid)\n        h_j = h.unsqueeze(1).expand(-1, N, -1, -1) # (B, N, N, D_hid)\n\n        # Calculate pairwise Minkowski dot products\n        p4_i = p4.unsqueeze(2).expand(-1, -1, N, -1) # (B, N, N, 4)\n        p4_j = p4.unsqueeze(1).expand(-1, N, -1, -1) # (B, N, N, 4)\n        dot_ij = minkowski_dot(p4_i, p4_j).unsqueeze(-1) # (B, N, N, 1)\n\n        # Prepare input for message MLP\n        pairwise_input = torch.cat([h_i, h_j, dot_ij], dim=-1) # (B, N, N, 2*D_hid + 1)\n\n        # Calculate messages\n        messages = self.mlp_msg(pairwise_input) # (B, N, N, D_hid)\n\n        # Mask invalid messages (padded particles)\n        pair_mask = mask.unsqueeze(2) * mask.unsqueeze(1) # (B, N, N)\n        messages = messages * pair_mask.unsqueeze(-1)\n\n        # Aggregate messages (sum over j)\n        aggregated_messages = messages.sum(dim=2) # (B, N, D_hid)\n\n        # Prepare input for update MLP\n        update_input = torch.cat([h, aggregated_messages], dim=-1) # (B, N, 2*D_hid)\n\n        # Update embeddings\n        h_new = self.mlp_update(update_input) # (B, N, D_hid)\n\n        # Residual connection and LayerNorm, apply mask\n        h_out = self.norm(h + h_new) * mask.unsqueeze(-1)\n\n        return h_out\n\n# ----- FREE SECTION: Training Loop Implementation -----\ndef train_model(model, train_loader, val_loader, epochs, lr=1e-3, weight_decay=1e-5):\n    device = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n    print(f\"Using device: {device}\")\n    model.to(device)\n\n    optimizer = torch.optim.Adam(model.parameters(), lr=lr, weight_decay=weight_decay)\n    criterion = nn.BCEWithLogitsLoss()\n    scheduler = torch.optim.lr_scheduler.ReduceLROnPlateau(optimizer, 'min', factor=0.1, patience=5)\n\n    training_loss = []\n    validation_loss = []\n    training_acc = []\n    validation_acc = []\n    best_val_auc = -1\n    best_model_state = None\n\n    for epoch in range(epochs):\n        model.train()\n        epoch_train_loss = 0.0\n        epoch_train_correct = 0\n        epoch_train_total = 0\n\n        for particle_batch, met_batch, mask_batch, labels_batch in train_loader:\n            particle_batch, met_batch, mask_batch, labels_batch = \\\n                particle_batch.to(device), met_batch.to(device), mask_batch.to(device), labels_batch.to(device).float()\n\n            optimizer.zero_grad()\n            outputs = model(particle_batch, met_batch, mask_batch)\n            loss = criterion(outputs, labels_batch)\n            loss.backward()\n            optimizer.step()\n\n            epoch_train_loss += loss.item() * labels_batch.size(0)\n            preds = torch.sigmoid(outputs) > 0.5\n            epoch_train_correct += (preds == labels_batch).sum().item()\n            epoch_train_total += labels_batch.size(0)\n\n        avg_train_loss = epoch_train_loss / epoch_train_total\n        avg_train_acc = epoch_train_correct / epoch_train_total\n        training_loss.append(avg_train_loss)\n        training_acc.append(avg_train_acc)\n\n        # Validation\n        model.eval()\n        epoch_val_loss = 0.0\n        epoch_val_correct = 0\n        epoch_val_total = 0\n        all_val_labels = []\n        all_val_preds = []\n\n        with torch.no_grad():\n            for particle_batch, met_batch, mask_batch, labels_batch in val_loader:\n                particle_batch, met_batch, mask_batch, labels_batch = \\\n                    particle_batch.to(device), met_batch.to(device), mask_batch.to(device), labels_batch.to(device).float()\n\n                outputs = model(particle_batch, met_batch, mask_batch)\n                loss = criterion(outputs, labels_batch)\n\n                epoch_val_loss += loss.item() * labels_batch.size(0)\n                preds_prob = torch.sigmoid(outputs)\n                preds_binary = preds_prob > 0.5\n                epoch_val_correct += (preds_binary == labels_batch).sum().item()\n                epoch_val_total += labels_batch.size(0)\n                all_val_labels.extend(labels_batch.cpu().numpy())\n                all_val_preds.extend(preds_prob.cpu().numpy())\n        \n        avg_val_loss = epoch_val_loss / epoch_val_total\n        avg_val_acc = epoch_val_correct / epoch_val_total\n        validation_loss.append(avg_val_loss)\n        validation_acc.append(avg_val_acc)\n\n        val_auc = -1 # Default if validation set is empty or other issues\n        if len(all_val_labels) > 0 and len(np.unique(all_val_labels)) > 1: # Check for valid AUC calculation\n            val_auc = roc_auc_score(all_val_labels, all_val_preds)\n        \n        print(f\"Epoch {epoch+1}/{epochs} - \"\n              f\"Train Loss: {avg_train_loss:.4f}, Train Acc: {avg_train_acc:.4f} - \"\n              f\"Val Loss: {avg_val_loss:.4f}, Val Acc: {avg_val_acc:.4f}, Val AUC: {val_auc:.4f}\")\n        \n        scheduler.step(avg_val_loss)\n\n        if val_auc > best_val_auc:\n            best_val_auc = val_auc\n            best_model_state = model.state_dict()\n            print(f\"New best validation AUC: {best_val_auc:.4f}\")\n\n    # Load best model state\n    if best_model_state is not None:\n        model.load_state_dict(best_model_state)\n        print(f\"Loaded model with best validation AUC: {best_val_auc:.4f}\")\n\n    return model, training_loss, validation_loss, training_acc, validation_acc\n\n# ----- FIXED SECTION: Plotting and Saving Outputs -----\ndef plot_and_save(metric_train, metric_val, metric_name, filename):\n    plt.figure()\n    plt.plot(metric_train, label=f'Training {metric_name}')\n    plt.plot(metric_val, label=f'Validation {metric_name}')\n    plt.title(f'{metric_name} per Epoch')\n    plt.xlabel('Epoch')\n    plt.ylabel(metric_name)\n    plt.legend()\n    plt.grid(True)\n    plt.savefig(filename)\n    plt.close()\n\n# ----- FIXED SECTION: Main Function -----\ndef main(dryrun=False):\n    # Data Loading\n    X_train, Y_train, X_val, Y_val = load_data()\n\n    # Hyperparameters\n    batch_size = 512\n    epochs = 3 if dryrun else 50 # Increased epochs for potentially better convergence\n    learning_rate = 5e-4 # Adjusted learning rate\n    hidden_dim = 128 # Increased model capacity\n    n_layers = 4 # More interaction layers\n    dropout_rate = 0.2 # Slightly increased dropout\n    weight_decay=1e-6 # Adjusted weight decay\n\n    # Preprocessing\n    # Note: preprocess_data now returns tuple-based datasets\n    train_loader, val_loader, preproc = preprocess_data(X_train, Y_train, X_val, Y_val, batch_size)\n\n    # Model Initialization\n    # Input dimension is handled internally by the model based on feature sizes\n    model = Classifier(hidden_dim=hidden_dim, n_layers=n_layers, dropout_rate=dropout_rate)\n\n    # Training\n    trained_model, training_loss, validation_loss, training_acc, validation_acc = train_model(\n        model, train_loader, val_loader, epochs=epochs, lr=learning_rate, weight_decay=weight_decay)\n\n    if not dryrun:\n        # determine base name & script directory\n        try:\n            script_path = os.path.abspath(sys.argv[0])\n        except: # Handle cases where sys.argv[0] might not be available (e.g. interactive) \n             script_path = os.path.abspath('script.py') # Fallback name\n\n        base       = os.path.splitext(os.path.basename(script_path))[0].removeprefix(\"script_\")\n        script_dir = os.path.dirname(script_path)\n        # Ensure script_dir exists or use current dir as fallback\n        if not script_dir: \n            script_dir = '.'\n        os.makedirs(script_dir, exist_ok=True)\n\n        # save model\n        model_path = os.path.join(script_dir, f\"{base}_model.pth\")\n        torch.save(trained_model.state_dict(), model_path)\n\n        # save scripted model\n        # Need to prepare dummy input for scripting based on model's forward signature\n        dummy_particles, dummy_met, dummy_mask, _ = next(iter(val_loader))\n        device = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n        # Must move model to CPU for scripting if trained on GPU\n        trained_model.to('cpu') \n        dummy_input = (dummy_particles.to('cpu'), dummy_met.to('cpu'), dummy_mask.to('cpu'))\n        scripted_path = os.path.join(script_dir, f\"{base}_scripted.pt\")\n        try:\n             scripted_model = torch.jit.script(trained_model, example_inputs=[dummy_input])\n             scripted_model.save(scripted_path)\n        except Exception as e:\n            print(f\"Could not script model: {e}\")\n\n        # save preprocessor\n        scripted_preproc = torch.jit.script(preproc)\n        scripted_preproc.save(os.path.join(script_dir, f\"{base}_preproc.pt\"))\n\n        # Plot and Save Metrics\n        plot_and_save(training_loss, validation_loss, f\"Loss - {base}\", os.path.join(script_dir, f\"{base}_loss.png\"))\n        plot_and_save(training_acc, validation_acc, f\"Accuracy - {base}\", os.path.join(script_dir, f\"{base}_accuracy.png\"))\n\n# ----- FIXED SECTION: Entry Point with Dry-run -----\nif __name__ == '__main__':\n    dryrun = '--dryrun' in sys.argv\n    main(dryrun=dryrun)\n",
  "explanation": "The code implements a particle physics classifier for the four-top-quark signal vs background task, aiming to maximize AUC by incorporating simplified Lorentz-equivariant principles within the provided PyTorch template.\n\n1.  **Data Loading & Constants:** The standard `load_data` function is used. Constants `N_FEATURES_TOTAL`, `N_MET_FEATURES`, `N_FEATURES_PER_OBJECT`, `N_MAX_OBJECTS` are defined based on the dataset description and input shape (105). It assumes each object has 5 features (`obj_id`, E, pT, eta, phi), leading to `N_MAX_OBJECTS = 20`, plus 2 MET features. A check and fallback are included if the dimensions don't match this assumption perfectly.\n\n2.  **Preprocessing (`PreprocessModule`, `preprocess_data`):**\n    *   `PreprocessModule` is designed to be TorchScript-compatible.\n    *   It extracts Missing Transverse Energy (MET) features (`E_T`, `phi_miss` converted to `E_T`, `METx`, `METy`).\n    *   It extracts particle features (`obj_id`, E, pT, eta, phi) for up to `N_MAX_OBJECTS` particles, reshaping the flat input.\n    *   It calculates particle 4-vectors (E, px, py, pz) from E, pT, eta, phi.\n    *   It creates a binary mask to identify real particles (based on pT > 0) versus zero-padding.\n    *   Crucially, it calculates mean and standard deviation for all relevant features (MET components, obj_id, 4-vector components) *only* from the training data and *only* considering real particles (using the mask).\n    *   These means and standard deviations are stored as buffers within `PreprocessModule`.\n    *   The `forward` method applies the normalization (`(x - mean) / std`) to the features and returns the normalized particle features (`obj_id` + 4-vector components, shape `[B, N, 5]`), normalized MET features (`[B, 3]`), and the mask (`[B, N]`) as a tuple.\n    *   `preprocess_data` orchestrates this: calculates stats, initializes the module, applies it to train/validation sets, and creates `DataLoader` instances. The datasets now yield tuples of tensors.\n\n3.  **Lorentz-Equivariant Style Model (`Classifier`, `InteractionLayer`):**\n    *   The `Classifier` takes the tuple output from the preprocessor: normalized particle features, normalized MET features, and the mask.\n    *   It uses an MLP (`particle_mlp`) to embed the initial features of each particle (normalized `obj_id`, E, px, py, pz).\n    *   It employs `InteractionLayer` modules inspired by Graph Neural Networks (GNNs) and concepts aiming for Lorentz equivariance:\n        *   `InteractionLayer` computes messages between all pairs of particles.\n        *   The message calculation (`mlp_msg`) uses the embeddings of the two particles (`h_i`, `h_j`) and their **Minkowski dot product** (`p4_i \u22c5 p4_j`). Using the Minkowski dot product, a Lorentz invariant quantity, to modulate the interaction is the core element incorporating Lorentz structure.\n        *   Messages are aggregated (summed) for each particle.\n        *   Particle embeddings are updated using the aggregated messages and a residual connection with Layer Normalization.\n        *   Masks are applied throughout to handle padding.\n    *   Multiple interaction layers (`n_layers`) allow information to propagate.\n    *   After interaction layers, particle embeddings are aggregated (masked mean pooling) into a single vector representing the particle system.\n    *   MET features are processed by a separate MLP (`met_mlp`).\n    *   The aggregated particle vector and MET vector are concatenated and passed to a final MLP (`final_mlp`) for binary classification (outputting logits).\n\n4.  **Training Loop (`train_model`):**\n    *   Standard PyTorch training loop using Adam optimizer and `BCEWithLogitsLoss`.\n    *   Moves data and model to GPU if available.\n    *   Tracks training/validation loss and accuracy per epoch.\n    *   **Crucially, calculates the validation AUC score at the end of each epoch** using `roc_auc_score` from scikit-learn. This requires collecting all predictions and true labels for the validation set.\n    *   Uses `ReduceLROnPlateau` learning rate scheduler based on validation loss.\n    *   Saves the model state corresponding to the **best validation AUC** achieved during training.\n    *   Prints train/validation metrics including AUC per epoch.\n\n5.  **Main Function & Output:**\n    *   Loads data, sets hyperparameters (batch size, epochs, learning rate, model dimensions, dropout).\n    *   Calls `preprocess_data` and `train_model`.\n    *   If not a dry run, it saves:\n        *   The trained model state dictionary (`.pth`).\n        *   The TorchScripted model (`.pt`), attempting scripting with an example input tuple.\n        *   The TorchScripted preprocessor module (`.pt`).\n        *   Plots of training/validation loss and accuracy over epochs.\n\nThis approach attempts to capture Lorentz symmetry by using 4-vectors explicitly and incorporating the Minkowski dot product (a Lorentz invariant) into the message passing scheme, aiming for improved physical relevance and AUC performance compared to a generic MLP operating on flattened features."
}
