            layers.append(nn.ReLU())
            layers.append(nn.Dropout(0.3))
            
        layers.append(nn.Linear(hidden_dims[-1], 1))
        layers.append(nn.Sigmoid())
        
        self.model = nn.Sequential(*layers)
    
    def forward(self, x):
