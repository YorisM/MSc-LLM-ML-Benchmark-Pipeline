import torch
import torch.nn as nn
import torch.optim as optim
import torch.nn.functional as F
import numpy as np
from sklearn.preprocessing import StandardScaler
from collections import defaultdict

class MyPreprocessor:
    def __init__(self):
        # Constants for data structure
        self.et_miss_idx = 0
        self.phi_et_miss_idx = 1
        self.obj_size = 5  # Each object has 5 values
        self.max_objects = 18  # Maximum number of objects
        
        # Scalers for normalization
        self.et_miss_scaler = StandardScaler()
        self.phi_miss_scaler = StandardScaler()
        self.object_scalers = {}
        
        # Object type mapping
        self.object_type_map = {}
        
        # Tracking statistics for feature engineering
        self.object_counts = defaultdict(int)
        self.means = {}
        self.stds = {}
    
    def fit(self, X, y=None):
        # Convert to numpy if tensor
        if isinstance(X, torch.Tensor):
            X = X.cpu().numpy()
        
        # Fit scalers for ET_miss and phi_ET_miss
        et_miss_data = X[:, self.et_miss_idx].reshape(-1, 1)
        phi_miss_data = X[:, self.phi_et_miss_idx].reshape(-1, 1)
        
        self.et_miss_scaler.fit(et_miss_data)
        self.phi_miss_scaler.fit(phi_miss_data)
        
        # Map object types to integers and count occurrences
        for i in range(self.max_objects):
            obj_start = 2 + i * self.obj_size
            obj_type_idx = obj_start
            
            # Extract object types and create mapping
            obj_types = X[:, obj_type_idx]
            unique_types = np.unique(obj_types)
            
            for obj_type in unique_types:
                if obj_type != 0:  # Skip padding
                    if obj_type not in self.object_type_map:
                        self.object_type_map[obj_type] = len(self.object_type_map) + 1  # Start from 1, 0 is padding
                    
                    # Count occurrences of each object type
                    mask = X[:, obj_type_idx] == obj_type
                    self.object_counts[obj_type] += np.sum(mask)
        
        # Create and fit scalers for each feature in objects by object type
        for obj_type in self.object_type_map:
            self.object_scalers[obj_type] = {
                'E': StandardScaler(),
                'pT': StandardScaler(),
                'eta': StandardScaler(),
                'phi': StandardScaler()
            }
            
            # Gather all instances of this object type
            type_data = {
                'E': [],
                'pT': [],
                'eta': [],
                'phi': []
            }
            
            for i in range(self.max_objects):
                obj_start = 2 + i * self.obj_size
                obj_type_idx = obj_start
                
                # Find instances of this object type
                mask = X[:, obj_type_idx] == obj_type
                if np.any(mask):
                    type_data['E'].extend(X[mask, obj_start + 1])
                    type_data['pT'].extend(X[mask, obj_start + 2])
                    type_data['eta'].extend(X[mask, obj_start + 3])
                    type_data['phi'].extend(X[mask, obj_start + 4])
            
            # Fit scalers for each feature
            for feature, data in type_data.items():
                if data:  # Only fit if we have data
                    self.object_scalers[obj_type][feature].fit(np.array(data).reshape(-1, 1))
        
        # Calculate global statistics for all valid (non-zero) features
        all_valid_features = []
        for i in range(X.shape[0]):
            row_features = []
            # Add ET_miss
            if X[i, self.et_miss_idx] != 0:
                row_features.append(X[i, self.et_miss_idx])
                
            # Process all objects
            for j in range(self.max_objects):
                obj_start = 2 + j * self.obj_size
                obj_type = X[i, obj_start]
                
                if obj_type != 0:  # Skip padding
                    for k in range(1, self.obj_size):  # Skip object type, process E, pT, eta, phi
                        feature_val = X[i, obj_start + k]
                        if feature_val != 0:
                            row_features.append(feature_val)
            
            if row_features:
                all_valid_features.append(row_features)
        
        # Calculate mean and std of features for imputation
        all_features = np.concatenate([np.array(f) for f in all_valid_features])
        self.means = {'global': np.mean(all_features)}
        self.stds = {'global': np.std(all_features)}
        
        return self
    
    def transform(self, X):
        # Convert to numpy if tensor
        is_tensor = isinstance(X, torch.Tensor)
        if is_tensor:
            X = X.cpu().numpy()
        
        # Initialize output features
        batch_size = X.shape[0]
        
        # Basic features
        missing_et = self.et_miss_scaler.transform(X[:, self.et_miss_idx].reshape(-1, 1)).flatten()
        missing_phi = self.phi_miss_scaler.transform(X[:, self.phi_et_miss_idx].reshape(-1, 1)).flatten()
        
        # Initialize count vectors for object types (one-hot)
        num_obj_types = len(self.object_type_map) + 1  # +1 for padding/unknown
        obj_type_counts = np.zeros((batch_size, num_obj_types))
        
        # Initialize aggregated features by object type
        obj_features = {}
        for obj_type in self.object_type_map:
            # For each object type, track sum and max of E, pT, eta, phi
            obj_features[obj_type] = {
                'E_sum': np.zeros(batch_size),
                'pT_sum': np.zeros(batch_size),
                'E_max': np.zeros(batch_size),
                'pT_max': np.zeros(batch_size),
                'eta_min': np.full(batch_size, float('inf')),
                'eta_max': np.full(batch_size, float('-inf')),
                'phi_range': np.zeros(batch_size),
                'count': np.zeros(batch_size)
            }
        
        # Process all objects
        for i in range(self.max_objects):
            obj_start = 2 + i * self.obj_size
            obj_type_idx = obj_start
            
            for b in range(batch_size):
                obj_type = X[b, obj_type_idx]
                
                if obj_type != 0:  # Skip padding
                    # Map object type to index (use 0 for unknown types)
                    type_idx = self.object_type_map.get(obj_type, 0)
                    obj_type_counts[b, type_idx] += 1
                    
                    # Process features for this object
                    if obj_type in self.object_type_map:
                        # Extract features
                        energy = X[b, obj_start + 1]
                        pt = X[b, obj_start + 2]
                        eta = X[b, obj_start + 3]
                        phi = X[b, obj_start + 4]
                        
                        # Apply scaling if values are non-zero
                        if energy != 0:
                            energy = self.object_scalers[obj_type]['E'].transform([[energy]])[0][0]
                        if pt != 0:
                            pt = self.object_scalers[obj_type]['pT'].transform([[pt]])[0][0]
                        if eta != 0:
                            eta = self.object_scalers[obj_type]['eta'].transform([[eta]])[0][0]
                        if phi != 0:
                            phi = self.object_scalers[obj_type]['phi'].transform([[phi]])[0][0]
                        
                        # Update aggregated features
                        obj_features[obj_type]['E_sum'][b] += energy
                        obj_features[obj_type]['pT_sum'][b] += pt
                        obj_features[obj_type]['E_max'][b] = max(obj_features[obj_type]['E_max'][b], energy)
                        obj_features[obj_type]['pT_max'][b] = max(obj_features[obj_type]['pT_max'][b], pt)
                        
                        if eta != 0:
                            obj_features[obj_type]['eta_min'][b] = min(obj_features[obj_type]['eta_min'][b], eta)
                            obj_features[obj_type]['eta_max'][b] = max(obj_features[obj_type]['eta_max'][b], eta)
                        
                        phi_vals = []
                        for j in range(self.max_objects):
                            j_start = 2 + j * self.obj_size
                            j_type = X[b, j_start]
                            if j_type == obj_type and X[b, j_start + 4] != 0:
                                phi_vals.append(X[b, j_start + 4])
                        
                        if len(phi_vals) > 1:
                            # Calculate phi range (handling circular nature)
                            phi_range = max(phi_vals) - min(phi_vals)
                            if phi_range > np.pi:
                                phi_range = 2 * np.pi - phi_range
                            obj_features[obj_type]['phi_range'][b] = phi_range
                        
                        obj_features[obj_type]['count'][b] += 1
        
        # Fix infinite values in eta_min/max
        for obj_type in obj_features:
            mask = obj_features[obj_type]['eta_min'] == float('inf')
            obj_features[obj_type]['eta_min'][mask] = 0
            
            mask = obj_features[obj_type]['eta_max'] == float('-inf')
            obj_features[obj_type]['eta_max'][mask] = 0
        
        # Calculate additional features
        total_obj_count = np.sum(obj_type_counts, axis=1)
        
        # Assemble all features
        feature_list = [
            missing_et.reshape(-1, 1),
            missing_phi.reshape(-1, 1),
            total_obj_count.reshape(-1, 1),
            obj_type_counts
        ]
        
        # Add aggregated features for each object type
        for obj_type in self.object_type_map:
            for feature_name, feature_values in obj_features[obj_type].items():
                feature_list.append(feature_values.reshape(-1, 1))
        
        # Calculate pairwise statistics between object types
        for i, type1 in enumerate(self.object_type_map):
            for j, type2 in enumerate(self.object_type_map):
                if j > i:  # Only calculate pairs once
                    # Calculate ratio of counts
                    ratio = np.zeros(batch_size)
                    t1_count = obj_features[type1]['count']
                    t2_count = obj_features[type2]['count']
                    
                    # Avoid division by zero
                    valid_mask = (t1_count > 0) & (t2_count > 0)
                    if np.any(valid_mask):
                        ratio[valid_mask] = t1_count[valid_mask] / t2_count[valid_mask]
                    
                    feature_list.append(ratio.reshape(-1, 1))
                    
                    # Add pt sum ratio
                    pt_ratio = np.zeros(batch_size)
                    t1_pt = obj_features[type1]['pT_sum']
                    t2_pt = obj_features[type2]['pT_sum']
                    
                    # Avoid division by zero
                    valid_mask = (t1_pt > 0) & (t2_pt > 0)
                    if np.any(valid_mask):
                        pt_ratio[valid_mask] = t1_pt[valid_mask] / t2_pt[valid_mask]
                    
                    feature_list.append(pt_ratio.reshape(-1, 1))
        
        # Concatenate all features
        transformed_features = np.hstack(feature_list)
        
        # Convert back to tensor if input was tensor
        if is_tensor:
            transformed_features = torch.tensor(transformed_features, dtype=torch.float32)
        
        return transformed_features

class ResidualBlock(nn.Module):
    def __init__(self, in_features, hidden_dim):
        super(ResidualBlock, self).__init__()
        self.block = nn.Sequential(
            nn.Linear(in_features, hidden_dim),
            nn.BatchNorm1d(hidden_dim),
            nn.ReLU(),
            nn.Dropout(0.2),
            nn.Linear(hidden_dim, in_features),
            nn.BatchNorm1d(in_features)
        )
        self.relu = nn.ReLU()
        
    def forward(self, x):
        residual = x
        x = self.block(x)
        x += residual
        return self.relu(x)

class ParticleClassifier(nn.Module):
    def __init__(self, input_dim, hidden_dim=128, num_blocks=3):
        super(ParticleClassifier, self).__init__()
        
        self.input_layer = nn.Sequential(
            nn.Linear(input_dim, hidden_dim),
            nn.BatchNorm1d(hidden_dim),
            nn.ReLU(),
            nn.Dropout(0.2)
        )
        
        self.res_blocks = nn.ModuleList([
            ResidualBlock(hidden_dim, hidden_dim//2) 
            for _ in range(num_blocks)
        ])
        
        self.output_layer = nn.Sequential(
            nn.Linear(hidden_dim, hidden_dim//2),
            nn.ReLU(),
            nn.Dropout(0.1),
            nn.Linear(hidden_dim//2, 1)
        )
        
    def forward(self, x):
        x = self.input_layer(x)
        
        for block in self.res_blocks:
            x = block(x)
            
        x = self.output_layer(x)
        return x.squeeze(-1)

def make_preprocessor():
    return MyPreprocessor()

def make_model(input_dim: int):
    model = ParticleClassifier(input_dim=input_dim, hidden_dim=256, num_blocks=4)
    return model

EPOCHS = 20

def train_model(model: nn.Module,
                train_loader: torch.utils.data.DataLoader,
                val_loader: torch.utils.data.DataLoader,
                epochs: int):
    device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')
    model = model.to(device)
    
    # Define loss function and optimizer
    criterion = nn.BCEWithLogitsLoss()
    optimizer = optim.Adam(model.parameters(), lr=0.001, weight_decay=1e-5)
    scheduler = optim.lr_scheduler.ReduceLROnPlateau(optimizer, mode='max', factor=0.5, patience=2, verbose=False)
    
    # Initialize tracking variables
    train_losses = []
    val_losses = []
    train_accuracies = []
    val_accuracies = []
    best_auc = 0.0
    best_model_state = None
    
    for epoch in range(epochs):
        # Training phase
        model.train()
        train_loss = 0.0
        train_correct = 0
        train_total = 0
        
        for X_batch, y_batch in train_loader:
            X_batch = X_batch.to(device)
            y_batch = y_batch.to(device).float()
            
            # Forward pass
            outputs = model(X_batch)
            loss = criterion(outputs, y_batch)
            
            # Backward pass and optimize
            optimizer.zero_grad()
            loss.backward()
            optimizer.step()
            
            # Track statistics
            train_loss += loss.item() * X_batch.size(0)
            
            # Calculate accuracy
            predictions = (torch.sigmoid(outputs) > 0.5).float()
            train_correct += (predictions == y_batch).sum().item()
            train_total += y_batch.size(0)
        
        # Calculate average training loss and accuracy for the epoch
        avg_train_loss = train_loss / train_total
        train_accuracy = train_correct / train_total
        train_losses.append(avg_train_loss)
        train_accuracies.append(train_accuracy)
        
        # Validation phase
        model.eval()
        val_loss = 0.0
        val_correct = 0
        val_total = 0
        all_outputs = []
        all_labels = []
        
        with torch.no_grad():
            for X_batch, y_batch in val_loader:
                X_batch = X_batch.to(device)
                y_batch = y_batch.to(device).float()
                
                # Forward pass
                outputs = model(X_batch)
                loss = criterion(outputs, y_batch)
                
                # Track statistics
                val_loss += loss.item() * X_batch.size(0)
                
                # Calculate accuracy
                predictions = (torch.sigmoid(outputs) > 0.5).float()
                val_correct += (predictions == y_batch).sum().item()
                val_total += y_batch.size(0)
                
                # Store outputs and labels for AUC calculation
                all_outputs.append(torch.sigmoid(outputs).cpu())
                all_labels.append(y_batch.cpu())
        
        # Calculate average validation loss and accuracy
        avg_val_loss = val_loss / val_total
        val_accuracy = val_correct / val_total
        val_losses.append(avg_val_loss)
        val_accuracies.append(val_accuracy)
        
        # Calculate AUC
        from sklearn.metrics import roc_auc_score
        y_true = torch.cat(all_labels).numpy()
        y_score = torch.cat(all_outputs).numpy()
        auc = roc_auc_score(y_true, y_score)
        
        # Update learning rate based on validation AUC
        scheduler.step(auc)
        
        # Save best model
        if auc > best_auc:
            best_auc = auc
            best_model_state = {k: v.cpu() for k, v in model.state_dict().items()}
    
    # Restore best model
    if best_model_state is not None:
        model.load_state_dict(best_model_state)
    
    return model, train_losses, val_losses, train_accuracies, val_accuracies
",
"explanation": "This solution addresses the particle physics classification challenge using a multi-layered approach:

1. Data Preprocessing (MyPreprocessor class):
   - The preprocessor identifies and handles the variable-length sequence data by understanding the structure (with ET_miss, phi_ET_miss, followed by object data).
   - It creates type-specific normalizations using separate StandardScalers for different particle types and their properties.
   - The transformation process creates informative aggregate features:
     * Object type counts and distributions
     * Sum and maximum of energy and transverse momentum for each object type
     * Eta (pseudorapidity) ranges and phi (azimuthal angle) distributions
     * Relational features between different object types (ratios of counts and pT sums)
   - This physics-informed feature engineering captures the essence of four-top events vs. background processes.

2. Model Architecture (ParticleClassifier):
   - Uses a ResNet-inspired architecture with residual connections to combat vanishing gradients.
   - The model has:
     * Input layer with batch normalization and dropout for regularization
     * Multiple residual blocks to learn complex patterns
     * Output layer that produces a scalar score for binary classification
   - Residual connections help maintain gradient flow through the network.

3. Training Strategy:
   - BCEWithLogitsLoss for binary classification
   - Adam optimizer with weight decay for regularization
   - Learning rate scheduling based on validation AUC performance
   - Tracking and saving the best model based on AUC (the target metric)
   - Early stopping implementation via best model tracking

Key Physics Insights Applied:
1. Different types of particles have distinct kinematic distributions, addressed through type-specific normalization.
2. The relative abundance of different particles helps distinguish signal from background.
3. Energy and momentum distributions are crucial for discerning rare four-top events.
4. Angular distributions (eta, phi) capture spatial patterns of particle jets and missing energy.
5. The missing transverse energy (ET_miss) is treated as a special feature given its importance in particle physics events.

The model is designed to be efficient for the given runtime constraints while maximizing the AUC metric, addressing the specific characteristics of the particle physics data without requiring excessive hyperparameter tuning."
}
