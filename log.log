    X_train, Y_train, X_val, Y_val = load_and_preprocess_data(is_dryrun=args.dryrun)
    
    # Train the model
    model, final_auc = train_model(X_train, Y_train, X_val, Y_val, model_filename, is_dryrun=args.dryrun)
    
