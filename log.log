"code": "# 0. ---------- IMPORTS ----------\nimport torch\nimport numpy as np\nfrom torch import nn\nfrom torch.utils.data import TensorDataset, DataLoader\nfrom sklearn.preprocessing import StandardScaler\nfrom torch.optim import Adam\nfrom torch.nn import functional as F\nfrom sklearn.metrics import roc_auc_score\n\n# 1. ---------- PRE-PROCESSING ----------\nclass MyPreprocessor:\n    def __init__(self):\n        self.scaler = StandardScaler()\n        self.n_objects = 18\n        self.features_per_object = 5  # obj_id, E, pT, eta, phi\n        self.obj_id_index = 0\n        self.E_index = 1\n        self.pT_index = 2\n        self.eta_index = 3\n        self.phi_index = 4\n        \n    def fit(self, X, y=None):\n        # Extract features and fit the scaler\n        features = self._extract_features(X)\n        self.scaler.fit(features)\n        return self\n    \n    def _extract_features(self, X):\n        batch_size = X.shape[0]\n        \n        # Split into ET_miss, phi_ET_miss and objects\n        ET_miss = X[:, 0].reshape(-1, 1)  # [batch_size, 1]\n        phi_ET_miss = X[:, 1].reshape(-1, 1)  # [batch_size, 1]\n        \n        # Reshape the rest into objects\n        objects_flat = X[:, 2:].reshape(batch_size, self.n_objects, self.features_per_object)\n        \n        # Extract valid objects (non-zero energy)\n        valid_mask = objects_flat[:, :, self.E_index] > 0\n        \n        # Features to normalize: ET_miss, object energies and pT\n        features_to_normalize = []\n        features_to_normalize.append(ET_miss.cpu().numpy())\n        \n        # Extract E and pT from all objects (we'll mask the zeros later)\n        E_all = objects_flat[:, :, self.E_index].reshape(batch_size, -1).cpu().numpy()\n        pT_all = objects_flat[:, :, self.pT_index].reshape(batch_size, -1).cpu().numpy()\n        \n        features_to_normalize.append(E_all)\n        features_to_normalize.append(pT_all)\n        \n        # Combine all features for normalization\n        return np.hstack(features_to_normalize)\n    \n    def transform(self, X):\n        batch_size = X.shape[0]\n        ET_miss = X[:, 0].reshape(-1, 1).clone()  # [batch_size, 1]\n        phi_ET_miss = X[:, 1].reshape(-1, 1).clone()  # [batch_size, 1]\n        \n        # Extract and reshape object data\n        objects = X[:, 2:].reshape(batch_size, self.n_objects, self.features_per_object).clone()\n        \n        # Create mask for valid objects (non-zero energy)\n        valid_mask = objects[:, :, self.E_index] > 0  # [batch_size, n_objects]\n        \n        # Count valid objects per event\n        object_counts = valid_mask.sum(dim=1)  # [batch_size]\n        \n        # Apply normalization to ET_miss, E, and pT\n        features_to_normalize = self._extract_features(X)\n        normalized_features = torch.tensor(self.scaler.transform(features_to_normalize), dtype=torch.float32)\n        \n        # Unpack normalized features\n        ET_miss_normalized = normalized_features[:, 0].reshape(-1, 1)\n        \n        # Offset for E and pT in normalized_features\n        E_offset = 1\n        pT_offset = E_offset + self.n_objects\n        \n        # Create a new tensor for objects with normalized values\n        normalized_objects = objects.clone()\n        \n        # Update E and pT with normalized values\n        for i in range(self.n_objects):\n            E_idx = E_offset + i\n            pT_idx = pT_offset + i\n            normalized_objects[:, i, self.E_index] = normalized_features[:, E_idx]\n            normalized_objects[:, i, self.pT_index] = normalized_features[:, pT_idx]\n        \n        # Calculate additional physics-informed features\n        \n        # 1. Sort objects by pT in descending order\n        pT_values = normalized_objects[:, :, self.pT_index]\n        _, pT_indices = torch.sort(pT_values, dim=1, descending=True)\n        batch_indices = torch.arange(batch_size).unsqueeze(1).expand(-1, self.n_objects)\n        sorted_objects = normalized_objects[batch_indices, pT_indices]\n        \n        # 2. Calculate Lorentz vectors and invariant mass features\n        # Convert to 4-momentum vectors (px, py, pz, E) for each object\n        px = sorted_objects[:, :, self.pT_index] * torch.cos(sorted_objects[:, :, self.phi_index])\n        py = sorted_objects[:, :, self.pT_index] * torch.sin(sorted_objects[:, :, self.phi_index]) \n        pz = sorted_objects[:, :, self.pT_index] * torch.sinh(sorted_objects[:, :, self.eta_index])\n        E = sorted_objects[:, :, self.E_index]\n        \n        # Calculate invariant mass of all object pairs\n        pair_features = []\n        for i in range(min(6, self.n_objects)):  # Consider up to 6 highest pT objects for pairs\n            for j in range(i+1, min(6, self.n_objects)):\n                # Dot product for pair (i,j)\n                dot_product = E[:, i] * E[:, j] - px[:, i] * px[:, j] - py[:, i] * py[:, j] - pz[:, i] * pz[:, j]\n                inv_mass = torch.sqrt(torch.abs(dot_product))\n                delta_phi = torch.abs(sorted_objects[:, i, self.phi_index] - sorted_objects[:, j, self.phi_index])\n                delta_phi = torch.min(delta_phi, 2*np.pi - delta_phi)\n                delta_eta = torch.abs(sorted_objects[:, i, self.eta_index] - sorted_objects[:, j, self.eta_index])\n                delta_R = torch.sqrt(delta_phi**2 + delta_eta**2)\n                \n                pair_features.append(torch.stack([inv_mass, delta_R, delta_phi, delta_eta], dim=1))\n        \n        pair_features = torch.cat(pair_features, dim=1)  # [batch_size, num_pairs * 4]\n        \n        # 3. Global event features\n        # Sum of object energies\n        total_E = torch.sum(E * valid_mask, dim=1, keepdim=True)\n        # Sum of transverse momenta\n        total_pT = torch.sum(sorted_objects[:, :, self.pT_index] * valid_mask, dim=1, keepdim=True)\n        # Object count (normalized)\n        obj_count = object_counts.unsqueeze(1) / self.n_objects\n        \n        # Centrality: ratio of ET_miss to sum of object pT\n        centrality = ET_miss.flatten() / (total_pT.flatten() + 1e-8)\n        centrality = centrality.unsqueeze(1)\n        \n        # 4. Prepare final feature tensor\n        # Take top 10 objects (ordered by pT)\n        top_objects = sorted_objects[:, :10].reshape(batch_size, -1)\n        \n        # Combine all features\n        global_features = torch.cat([ET_miss_normalized, phi_ET_miss, total_E, total_pT, obj_count, centrality], dim=1)\n        \n        final_features = torch.cat([global_features, top_objects.reshape(batch_size, -1), pair_features], dim=1)\n        \n        return final_features\n    \n    def fit_transform(self, X, y=None):\n        self.fit(X, y)\n        return self.transform(X)\n\ndef make_preprocessor():\n    return MyPreprocessor()\n\n# 2. ---------- MODEL DEFINITION ----------\nclass LorentzEquivariantLayer(nn.Module):\n    def __init__(self, input_dim, output_dim):\n        super().__init__()\n        self.linear = nn.Linear(input_dim, output_dim)\n        \n    def forward(self, x):\n        return self.linear(x)\n\nclass EquivariantMessagePassing(nn.Module):\n    def __init__(self, node_dim, edge_dim, hidden_dim):\n        super().__init__()\n        self.node_update = nn.Sequential(\n            nn.Linear(node_dim + edge_dim, hidden_dim),\n            nn.ReLU(),\n            nn.Linear(hidden_dim, node_dim)\n        )\n    \n    def forward(self, nodes, edges, edge_index):\n        # Simple message passing implementation\n        batch_size = nodes.size(0)\n        updated_nodes = []\n        \n        for b in range(batch_size):\n            node_feats = nodes[b]\n            edge_feats = edges[b]\n            src, dst = edge_index\n            \n            # Aggregate messages from neighbors\n            messages = torch.zeros_like(node_feats)\n            for i in range(len(src)):\n                s, d = src[i], dst[i]\n                messages[d] += torch.cat([node_feats[s], edge_feats[i]], dim=0)\n            \n            # Update nodes\n            updated = self.node_update(messages)\n            updated_nodes.append(updated + node_feats)  # Residual connection\n        \n        return torch.stack(updated_nodes)\n\nclass TopQuarksClassifier(nn.Module):\n    def __init__(self, input_dim):\n        super().__init__()\n        # Feature embedding\n        self.embedding = nn.Sequential(\n            nn.Linear(input_dim, 256),\n            nn.LayerNorm(256),\n            nn.ReLU(),\n            nn.Dropout(0.2)\n        )\n        \n        # Lorentz equivariant layers\n        self.lorentz_layer1 = LorentzEquivariantLayer(256, 128)\n        self.lorentz_layer2 = LorentzEquivariantLayer(128, 64)\n        \n        # Final classification layers\n        self.classifier = nn.Sequential(\n            nn.Linear(64, 32),\n            nn.ReLU(),\n            nn.Dropout(0.1),\n            nn.Linear(32, 1)\n        )\n    \n    def forward(self, x):\n        x = self.embedding(x)\n        x = F.relu(self.lorentz_layer1(x))\n        x = F.relu(self.lorentz_layer2(x))\n        logits = self.classifier(x).squeeze(-1)\n        return logits\n\ndef make_model(input_dim):\n    model = TopQuarksClassifier(input_dim)\n    return model\n\n# 3. ---------- MODEL TRAINING ----------\nEPOCHS = 25   \ndef train_model(model, train_loader, val_loader, epochs):\n    device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')\n    model = model.to(device)\n    \n    # Initialize optimizer with weight decay for regularization\n    optimizer = Adam(model.parameters(), lr=0.001, weight_decay=1e-5)\n    \n    # Learning rate scheduler\n    scheduler = torch.optim.lr_scheduler.ReduceLROnPlateau(\n        optimizer, mode='max', factor=0.5, patience=3, verbose=True\n    )\n    \n    # Initialize tracking metrics\n    train_loss = []\n    val_loss = []\n    train_acc = []\n    val_acc = []\n    best_val_auc = 0.0\n    best_model_state = None\n    \n    for epoch in range(epochs):\n        # Training phase\n        model.train()\n        epoch_train_loss = 0.0\n        epoch_train_correct = 0\n        epoch_train_total = 0\n        \n        for X_batch, y_batch in train_loader:\n            X_batch, y_batch = X_batch.to(device), y_batch.to(device)\n            \n            # Zero gradients\n            optimizer.zero_grad()\n            \n            # Forward pass\n            logits = model(X_batch)\n            loss = F.binary_cross_entropy_with_logits(logits, y_batch.float())\n            \n            # Backward pass and optimize\n            loss.backward()\n            optimizer.step()\n            \n            # Track metrics\n            epoch_train_loss += loss.item() * X_batch.size(0)\n            predictions = (torch.sigmoid(logits) > 0.5).float()\n            epoch_train_correct += (predictions == y_batch.float()).sum().item()\n            epoch_train_total += y_batch.size(0)\n        \n        # Compute epoch metrics\n        epoch_train_loss /= epoch_train_total\n        epoch_train_acc = epoch_train_correct / epoch_train_total\n        train_loss.append(epoch_train_loss)\n        train_acc.append(epoch_train_acc)\n        \n        # Validation phase\n        model.eval()\n        epoch_val_loss = 0.0\n        epoch_val_correct = 0\n        epoch_val_total = 0\n        all_val_preds = []\n        all_val_labels = []\n        \n        with torch.no_grad():\n            for X_batch, y_batch in val_loader:\n                X_batch, y_batch = X_batch.to(device), y_batch.to(device)\n                \n                # Forward pass\n                logits = model(X_batch)\n                loss = F.binary_cross_entropy_with_logits(logits, y_batch.float())\n                \n                # Track metrics\n                epoch_val_loss += loss.item() * X_batch.size(0)\n                predictions = (torch.sigmoid(logits) > 0.5).float()\n                epoch_val_correct += (predictions == y_batch.float()).sum().item()\n                epoch_val_total += y_batch.size(0)\n                \n                # Collect predictions and labels for AUC computation\n                all_val_preds.append(torch.sigmoid(logits).cpu().numpy())\n                all_val_labels.append(y_batch.cpu().numpy())\n        \n        # Compute epoch metrics\n        epoch_val_loss /= epoch_val_total\n        epoch_val_acc = epoch_val_correct / epoch_val_total\n        val_loss.append(epoch_val_loss)\n        val_acc.append(epoch_val_acc)\n        \n        # Compute validation AUC\n        all_val_preds = np.concatenate(all_val_preds)\n        all_val_labels = np.concatenate(all_val_labels)\n        val_auc = roc_auc_score(all_val_labels, all_val_preds)\n        \n        # Update learning rate based on validation AUC\n        scheduler.step(val_auc)\n        \n        # Save best model\n        if val_auc > best_val_auc:\n            best_val_auc = val_auc\n            best_model_state = model.state_dict().copy()\n        \n        print(f'Epoch {epoch+1}/{epochs} | '\n              f'Train Loss: {epoch_train_loss:.4f} | Train Acc: {epoch_train_acc:.4f} | '\n              f'Val Loss: {epoch_val_loss:.4f} | Val Acc: {epoch_val_acc:.4f} | '\n              f'Val AUC: {val_auc:.4f}')\n    \n    # Load the best model\n    if best_model_state is not None:\n        model.load_state_dict(best_model_state)\n    \n    return model, train_loss, val_loss, train_acc, val_acc",
"explanation": "This solution implements a physics-inspired deep learning model for classifying four top quark events in particle physics. Here's an explanation of the key components:

