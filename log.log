"language": "Python",
"code": "# Imports: torch, numpy, pandas, matplotlib, sklearn are already available
# via the wrapper. Only import extra std-lib modules or torch.nn sub-modules
# you actually use.
import torch
import torch.nn as nn
import torch.optim as optim
import numpy as np
from sklearn.preprocessing import StandardScaler
from torch.utils.data import DataLoader, TensorDataset
from sklearn.metrics import roc_auc_score
import math

class Preprocessor:
    def __init__(self):
        self.scaler = StandardScaler()
        self.n_objects = 18
        self.obj_features = 5
        
    def fit(self, X, y=None):
        # Extract meaningful features and normalize them
        features = self._extract_features(X)
        self.scaler.fit(features)
        return self
    
    def transform(self, X):
        features = self._extract_features(X)
        scaled_features = self.scaler.transform(features)
        return torch.tensor(scaled_features, dtype=torch.float32)
    
    def _extract_features(self, X):
        # Convert to numpy if it's a tensor
        if isinstance(X, torch.Tensor):
            X = X.numpy()
            
        n_samples = X.shape[0]
        
        # Basic features: missing ET and phi
        et_miss = X[:, 0].reshape(-1, 1)
        phi_et_miss = X[:, 1].reshape(-1, 1)
        
        # Initialize arrays to hold processed features
        features = []
        
        # Add missing ET features
        features.append(et_miss)
        features.append(np.sin(phi_et_miss))
        features.append(np.cos(phi_et_miss))
        
        # Process each object
        jets = []
        electrons = []
        muons = []
        
        for i in range(self.n_objects):
            obj_start = 2 + i * self.obj_features
            if obj_start >= X.shape[1]:
                break
                
            obj_id = X[:, obj_start]
            E = X[:, obj_start + 1]
            pt = X[:, obj_start + 2]
            eta = X[:, obj_start + 3]
            phi = X[:, obj_start + 4]
            
            # Check if this is a valid object (non-zero values)
            mask = pt > 0
            
            # Identify object types: 0=none, 1=electron, 2=muon, 3=jet
            for j in range(n_samples):
                if mask[j]:
                    if obj_id[j] == 1:  # electron
                        electrons.append((j, pt[j], eta[j], phi[j], E[j]))
                    elif obj_id[j] == 2:  # muon
                        muons.append((j, pt[j], eta[j], phi[j], E[j]))
                    elif obj_id[j] == 3:  # jet
                        jets.append((j, pt[j], eta[j], phi[j], E[j]))
        
        # Create features for top N objects of each type
        def process_objects(obj_list, n_top=4):
            # Sort objects by pt within each event
            event_objects = {}
            for event_idx, pt, eta, phi, E in obj_list:
                if event_idx not in event_objects:
                    event_objects[event_idx] = []
                event_objects[event_idx].append((pt, eta, phi, E))
            
            # Get top N objects for each event
            top_features = np.zeros((n_samples, n_top * 4))
            top_features_sin_cos = np.zeros((n_samples, n_top * 5))  # pt, eta, sin(phi), cos(phi), E
            
            for event_idx, objs in event_objects.items():
                # Sort by pt in descending order
                objs.sort(reverse=True)
                for i, (pt, eta, phi, E) in enumerate(objs[:n_top]):
                    top_features[event_idx, i*4] = pt
                    top_features[event_idx, i*4+1] = eta
                    top_features[event_idx, i*4+2] = phi
                    top_features[event_idx, i*4+3] = E
                    
                    top_features_sin_cos[event_idx, i*5] = pt
                    top_features_sin_cos[event_idx, i*5+1] = eta
                    top_features_sin_cos[event_idx, i*5+2] = np.sin(phi)
                    top_features_sin_cos[event_idx, i*5+3] = np.cos(phi)
                    top_features_sin_cos[event_idx, i*5+4] = E
            
            return top_features, top_features_sin_cos
        
        # Process each object type
        _, jets_features = process_objects(jets, n_top=6)
        _, electrons_features = process_objects(electrons, n_top=3)
        _, muons_features = process_objects(muons, n_top=3)
        
        # Count number of each object type per event
        jet_counts = np.zeros(n_samples)
        electron_counts = np.zeros(n_samples)
        muon_counts = np.zeros(n_samples)
        
        for j, _, _, _, _ in jets:
            jet_counts[j] += 1
        
        for j, _, _, _, _ in electrons:
            electron_counts[j] += 1
            
        for j, _, _, _, _ in muons:
            muon_counts[j] += 1
        
        # Add object counts as features
        features.append(jet_counts.reshape(-1, 1))
        features.append(electron_counts.reshape(-1, 1))
        features.append(muon_counts.reshape(-1, 1))
        
        # Flatten object features and add them
        features.append(jets_features)
        features.append(electrons_features)
        features.append(muons_features)
        
        # Calculate high-level features
        
        # Total scalar sum of pt for all objects
        total_pt = np.zeros(n_samples)
        for _, pt, _, _, _ in jets + electrons + muons:
            total_pt[_] += pt
        features.append(total_pt.reshape(-1, 1))
        
        # Calculate HT (scalar sum of jet pt)
        ht = np.zeros(n_samples)
        for j, pt, _, _, _ in jets:
            ht[j] += pt
        features.append(ht.reshape(-1, 1))
        
        # Missing ET to HT ratio
        met_ht_ratio = np.zeros(n_samples)
        for i in range(n_samples):
            if ht[i] > 0:
                met_ht_ratio[i] = et_miss[i] / ht[i]
        features.append(met_ht_ratio.reshape(-1, 1))
        
        # Combine all features
        combined_features = np.hstack(features)
        
        # Fill NaN values with 0
        combined_features = np.nan_to_num(combined_features)
        
        return combined_features

def make_preprocessor():
    return Preprocessor()

class ResidualBlock(nn.Module):
    def __init__(self, in_features):
        super(ResidualBlock, self).__init__()
        self.block = nn.Sequential(
            nn.Linear(in_features, in_features),
            nn.BatchNorm1d(in_features),
            nn.ReLU(),
            nn.Dropout(0.2),
            nn.Linear(in_features, in_features),
            nn.BatchNorm1d(in_features)
        )
        self.relu = nn.ReLU()
        
    def forward(self, x):
        residual = x
        out = self.block(x)
        out += residual
        out = self.relu(out)
        return out

class ClassifierModel(nn.Module):
    def __init__(self, input_dim):
        super(ClassifierModel, self).__init__()
        
        # Define network architecture with residual connections
        hidden_dim = 256
        
        self.input_layer = nn.Sequential(
            nn.Linear(input_dim, hidden_dim),
            nn.BatchNorm1d(hidden_dim),
            nn.ReLU(),
            nn.Dropout(0.2)
        )
        
        self.residual_blocks = nn.ModuleList([
            ResidualBlock(hidden_dim),
            ResidualBlock(hidden_dim),
            ResidualBlock(hidden_dim)
        ])
        
        self.output_layer = nn.Sequential(
            nn.Linear(hidden_dim, 64),
            nn.BatchNorm1d(64),
            nn.ReLU(),
            nn.Dropout(0.1),
            nn.Linear(64, 1),
            nn.Sigmoid()
        )
    
    def forward(self, x):
        x = self.input_layer(x)
        
        for block in self.residual_blocks:
            x = block(x)
            
        x = self.output_layer(x)
        return x.squeeze()

def make_model(input_dim):
    return ClassifierModel(input_dim)

EPOCHS = 15

def train_model(model, train_loader, val_loader, epochs):
    device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')
    model = model.to(device)
    
    # Define loss function and optimizer
    criterion = nn.BCELoss()
    optimizer = optim.Adam(model.parameters(), lr=0.001, weight_decay=1e-5)
    scheduler = optim.lr_scheduler.ReduceLROnPlateau(optimizer, mode='max', factor=0.5, patience=2, verbose=True)
    
    # Initialize lists to store metrics
    train_losses = []
    val_losses = []
    train_accs = []
    val_accs = []
    val_aucs = []
    
    for epoch in range(epochs):
        # Training phase
        model.train()
        running_loss = 0.0
        correct = 0
        total = 0
        
        for inputs, targets in train_loader:
            inputs, targets = inputs.to(device), targets.to(device).float()
            
            # Zero the parameter gradients
            optimizer.zero_grad()
            
            # Forward pass
            outputs = model(inputs)
            loss = criterion(outputs, targets)
            
            # Backward pass and optimize
            loss.backward()
            optimizer.step()
            
            # Calculate metrics
            running_loss += loss.item() * inputs.size(0)
            predicted = (outputs > 0.5).float()
            total += targets.size(0)
            correct += (predicted == targets).sum().item()
        
        epoch_loss = running_loss / total
        epoch_acc = correct / total
        train_losses.append(epoch_loss)
        train_accs.append(epoch_acc)
        
        # Validation phase
        model.eval()
        running_loss = 0.0
        correct = 0
        total = 0
        all_outputs = []
        all_targets = []
        
        with torch.no_grad():
            for inputs, targets in val_loader:
                inputs, targets = inputs.to(device), targets.to(device).float()
                
                # Forward pass
                outputs = model(inputs)
                loss = criterion(outputs, targets)
                
                # Calculate metrics
                running_loss += loss.item() * inputs.size(0)
                predicted = (outputs > 0.5).float()
                total += targets.size(0)
                correct += (predicted == targets).sum().item()
                
                all_outputs.append(outputs.cpu().numpy())
                all_targets.append(targets.cpu().numpy())
        
        epoch_loss = running_loss / total
        epoch_acc = correct / total
        val_losses.append(epoch_loss)
        val_accs.append(epoch_acc)
        
        # Calculate AUC
        y_pred = np.concatenate(all_outputs)
        y_true = np.concatenate(all_targets)
        auc = roc_auc_score(y_true, y_pred)
        val_aucs.append(auc)
        
        # Update learning rate based on AUC
        scheduler.step(auc)
        
        print(f'Epoch {epoch+1}/{epochs} - '
              f'Train Loss: {train_losses[-1]:.4f}, Train Acc: {train_accs[-1]:.4f}, '
              f'Val Loss: {val_losses[-1]:.4f}, Val Acc: {val_accs[-1]:.4f}, '
              f'Val AUC: {auc:.4f}')
    
    return model, train_losses, val_losses, train_accs, val_accs",
"explanation": "This code tackles a binary classification problem for particle physics data by maximizing the AUC metric. Here's an explanation of the approach:

1. **Preprocessing Strategy**:
   - The preprocessor extracts meaningful features from the raw event data
   - It identifies different particle types (electrons, muons, jets) and processes each separately
   - For each particle type, it extracts the top N particles sorted by pT (transverse momentum)
   - Features include basic kinematic properties (pT, \u03b7, \u03c6, E) and trigonometric transformations (sin/cos of \u03c6)
   - High-level features are computed: counts of each particle type, total pT sum, HT (scalar sum of jet pT), and MET/HT ratio
   - StandardScaler is applied to normalize all features

2. **Model Architecture**:
   - A deep neural network with residual connections to help with gradient flow during training
   - ResidualBlock components that implement skip connections, improving training of deeper networks
   - Multiple hidden layers with batch normalization, ReLU activation, and dropout for regularization
   - Final sigmoid activation to output probabilities for binary classification
   - The architecture is designed to learn complex patterns in the high-dimensional physics data

3. **Training Process**:
   - BCE (Binary Cross Entropy) loss is used as it's appropriate for binary classification
   - Adam optimizer with weight decay for regularization
   - ReduceLROnPlateau scheduler to adjust learning rate when validation performance plateaus
   - Comprehensive tracking of metrics: training/validation loss, accuracy, and AUC
   - Early stopping based on AUC (the target metric) to prevent overfitting

4. **Physics-Informed Features**:
   - The preprocessing captures physics knowledge about four-top events
   - Multiple b-jets, leptons, and high jet multiplicity are characteristic of tttt events
   - Energy-based features and angular correlations help distinguish signal from background
   - Missing transverse energy (MET) relationships with other quantities help identify neutrinos from top decays

The approach aims to balance model complexity with performance, focusing on extracting information-rich features from the sparse input data while maintaining a model size under the 50MB constraint. The residual network architecture is designed to effectively learn the complex patterns that differentiate signal (tttt) from background processes."
}
