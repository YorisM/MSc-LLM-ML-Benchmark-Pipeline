ch.sinh(eta)\n        p_mu = torch.cat([E, px, py, pz], dim=-1) * mask_expanded # [B, N, 4]\n        p_mu = torch.nan_to_num(p_mu, nan=0.0)\n\n        # 3. Calculate initial features\n        m2 = self.lorentz_dot(p_mu, p_mu) # [B, N, 1]\n        m2 = torch.relu(m2) # Ensure non-negative physical mass^2\n        m2 = torch.nan_to_num(m2, nan=0.0) * mask_expanded\n        \n        # Initial scalar node features (embedding of m^2)\n        s = self.scalar_init_mlp(m2) * mask_expanded # [B, N, hidden_dim]\n        # Vector node features (remain the 4-vectors)\n        v = p_mu # [B, N, 4]\n\n        # 4. Message Passing Layers\n        for edge_mlp in self.layers:\n            # Expand features for pairwise computation\n            s_i = s.unsqueeze(2).expand(-1, -1, self.max_objs, -1) # [B, N, N, h]\n            s_j = s.unsqueeze(1).expand(-1, self.max_objs, -1, -1) # [B, N, N, h]\n            v_i = v.unsqueeze(2).expand(-1, -1, self.max_objs, -1) # [B, N, N, 4]\n            v_j = v.unsqueeze(1).expand(-1, self.max_objs, -1, -1) # [B, N, N, 4]\n            m2_i = m2.unsqueeze(2).expand(-1, -1, self.max_objs, -1) # [B, N, N, 1]\n            m2_j = m2.unsqueeze(1).expand(-1, self.max_objs, -1, -1) # [B, N, N, 1]\n\n            # Pairwise Lorentz dot product [B, N, N, 1]\n            dot_ij = self.lorentz_dot(v_i, v_j) * mask_pair_expanded\n            dot_ij = torch.nan_to_num(dot_ij, nan=0.0)\n\n            # Form edge features\n            edge_features = torch.cat([s_i, s_j, dot_ij, m2_i, m2_j], dim=-1) # [B, N, N, 2h+3]\n            \n            # Compute messages using edge MLP\n            messages = edge_mlp(edge_features) * mask_pair_expanded # [B, N, N, h]\n            \n            # Aggregate messages by summing over j\n            agg_message = torch.sum(messages, dim=2) # [B, N, h]\n\n            # Update scalar node features (residual connection)\n            s = s + agg_message # [B, N, h]\n            # Optional: Add LayerNorm/activation here? e.g., s = nn.ReLU()(s) or nn.LayerNorm(hidden_dim)(s)\n            # Vectors 'v' remain unchanged in this simplified model\n\n        # 5. Pooling / Aggregation\n        s_agg = torch.sum(s * mask_expanded, dim=1) # [B, h] (Sum over N)\n        v_agg = torch.sum(v * mask_expanded, dim=1) # [B, 4] (Sum over N)\n        \n        # 6. Construct Final Invariant Features\n        v_agg_m2 = self.lorentz_dot(v_agg.unsqueeze(1), v_agg.unsqueeze(1)).squeeze(-1) # [B, 1]\n        v_agg_m2 = torch.relu(v_agg_m2) # Ensure non-negative\n        v_agg_m2 = torch.nan_to_num(v_agg_m2, nan=0.0)\n        
        # Normalize MET magnitude (simple heuristic scaling)\n        met_norm = met_mag / 1000.0 # Assume MET is in MeV, scale to GeV range\n\n        final_features = torch.cat([s_agg, v_agg_m2, met_norm], dim=-1) # [B, h + 1 + 1]\n\n        # 7. Final MLP for classification\n        logits = self.final_mlp(final_features) # [B, 1]\n\n        return logits.squeeze(-1) # Return logits [B]\n\n# ----- FREE SECTION: Training Loop Implementation -----\ndef train_model(model, train_loader, val_loader, epochs=10, learning_rate=1e-3):\n    device = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n    model.to(device)\n    \n    optimizer = torch.optim.Adam(model.parameters(), lr=learning_rate)\n    criterion = nn.BCEWithLogitsLoss()\n    \n    history = defaultdict(list)\n\n    print(f\"Starting training on {device}\")\n    for epoch in range(epochs):\n        model.train()\n        epoch_train_loss = 0.0\n        train_preds, train_targets = [], []\n        \n        for i, (batch_X, batch_Y) in enumerate(train_loader):\n            batch_X, batch_Y = batch_X.to(device), batch_Y.to(device)\n            \n            optimizer.zero_grad()\n            outputs = model(batch_X)\n            loss = criterion(outputs, batch_Y.float())\n            loss.backward()\n            optimizer.step()\n            \n            epoch_train_loss += loss.item()\n            train_preds.extend(torch.sigmoid(outputs).detach().cpu().numpy())\n            train_targets.extend(batch_Y.detach().cpu().numpy())\n            \n            if i % 100 == 0: # Print progress every 100 batches\n                 print(f'Epoch {epoch+1}/{epochs}, Batch {i}/{len(train_loader)}, Loss: {loss.item():.4f}')\n\n        avg_train_loss = epoch_train_loss / len(train_loader)\n        train_acc = accuracy_score(np.round(train_preds), train_targets)\n        train_auc = roc_auc_score(train_targets, train_preds)\n        history['train_loss'].append(avg_train_loss)\n        history['train_acc'].append(train_acc)\n        history['train_auc'].append(train_auc)\n\n        # Validation phase\n        model.eval()\n        epoch_val_loss = 0.0\n        val_preds, val_targets = [], []\n        with torch.no_grad():\n            for batch_X, batch_Y in val_loader:\n                batch_X, batch_Y = batch_X.to(device), batch_Y.to(device)\n                outputs = model(batch_X)\n                loss = criterion(outputs, batch_Y.float())\n                epoch_val_loss += loss.item()\n                val_preds.extend(torch.sigmoid(outputs).cpu().numpy())\n                val_targets.extend(batch_Y.cpu().numpy())\n        \n        avg_val_loss = epoch_val_loss / len(val_loader)\n        val_acc = accuracy_score(np.round(val_preds), val_targets)\n        val_auc = roc_auc_score(val_targets, val_preds)\n        history['val_loss'].append(avg_val_loss)\n        history['val_acc'].append(val_acc)\n        history['val_auc'].append(val_auc)\n\n        print(f\"Epoch {epoch+1}/{epochs}\")\n        print(f\"  Train Loss: {avg_train_loss:.4f}, Train Acc: {train_acc:.4f}, Train AUC: {train_auc:.4f}\")\n        print(f\"  Val Loss:   {avg_val_loss:.4f}, Val Acc:   {val_acc:.4f}, Val AUC:   {val_auc:.4f}\")\n\n    # Return trained model and history for plotting\n    return model, history['train_loss'], history['val_loss'], history['train_acc'], history['val_acc']\n\n# ----- FIXED SECTION: Plotting and Saving Outputs -----\ndef plot_and_save(metric_train, metric_val, metric_name, filename):\n    plt.figure()\n    plt.plot(metric_train, label=f'Training {metric_name}')\n    plt.plot(metric_val, label=f'Validation {metric_name}')\n    plt.title(f'{metric_name} per Epoch')\n    plt.xlabel('Epoch')\n    plt.ylabel(metric_name)\n    plt.legend()\n    plt.grid(True)\n    plt.savefig(filename)\n    plt.close()\n\n# ----- FIXED SECTION: Main Function -----\ndef main(dryrun=False):\n    # Data Loading\n    X_train, Y_train, X_val, Y_val = load_data()\n\n    # Preprocessing\n    # Define batch size here or pass as arg\n    batch_size = 256\n    train_loader, val_loader, preproc = preprocess_data(X_train, Y_train, X_val, Y_val, batch_size=batch_size)\n\n    # Model Initialization\n    # Infer input dim from data although we hardcoded parts based on assumptions\n    sample_X, _, = next(iter(train_loader))\n    model = Classifier(input_dim=sample_X.shape[1], num_layers=3, hidden_dim=64)\n\n    # Training\n    epochs = 1 if dryrun else 20 # Increased epochs for better convergence\n    learning_rate = 5e-4 # Adjusted learning rate\n\n    # Train the model\n    trained_model, training_loss, validation_loss, training_acc, validation_acc = train_model(\n        model, train_loader, val_loader, epochs=epochs, learning_rate=learning_rate)\n\n    if not dryrun:\n        # determine base name & script directory\n        script_name = os.path.basename(sys.argv[0])\n        base = os.path.splitext(script_name)[0].removeprefix(\"script_\")\n        if not base: base = \"fourtops_lorentz_model\" # Default name if script name is unusual\n        script_dir = os.path.dirname(os.path.abspath(sys.argv[0]))\n        results_dir = os.path.join(script_dir, \"results\")\n        os.makedirs(results_dir, exist_ok=True)\n\n        # save model\n        model_path = os.path.join(results_dir, f\"{base}_model.pth\")\n        torch.save(trained_model.state_dict(), model_path)\n\n        # save scripted model (ensure model is scriptable)\n        try:\n            scripted_model = torch.jit.script(trained_model)\n            scripted_path = os.path.join(results_dir, f\"{base}_scripted.pt\")\n            scripted_model.save(scripted_path)\n        except Exception as e:\n            print(f\"Could not script model: {e}\")\n\n        # save preprocessor\n        try:\n            scripted_preproc = torch.jit.script(preproc)\n            scripted_preproc.save(os.path.join(results_dir, f\"{base}_preproc.pt\"))\n        except Exception as e:\n            print(f\"Could not script