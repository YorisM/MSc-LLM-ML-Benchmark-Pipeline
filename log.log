import torch
import torch.nn as nn
from torch.utils.data import Dataset, DataLoader
import numpy as np
from sklearn.metrics import roc_auc_score
from sklearn.model_selection import train_test_split
from sklearn.preprocessing import StandardScaler
import argparse

# Define the dataset class
class EventDataset(Dataset):
    def __init__(self, X, Y):
        self.X = X
        self.Y = Y

    def __len__(self):
        return len(self.X)

    def __getitem__(self, index):
        return self.X[index], self.Y[index]

# Define the binary classifier model
class BinaryClassifier(nn.Module):
    def __init__(self):
        super(BinaryClassifier, self).__init__()
        self.fc1 = nn.Linear(106, 128)
        self.fc2 = nn.Linear(128, 64)
        self.fc3 = nn.Linear(64, 2)

    def forward(self, x):
        x = torch.relu(self.fc1(x))
        x = torch.relu(self.fc2(x))
        x = self.fc3(x)
        return x

def train(model, device, loader, optimizer, criterion):
    model.train()
    for batch_idx, (data, target) in enumerate(loader):
        data, target = data.to(device), target.to(device)
        optimizer.zero_grad()
        output = model(data)
        loss = criterion(output, target.long())
        loss.backward()
        optimizer.step()

def evaluate(model, device, loader):
    model.eval()
    total_correct = 0
    pred_probs = []
    targets = []
    with torch.no_grad():
        for data, target in loader:
            data, target = data.to(device), target.to(device)
            output = model(data)
            _, predicted = torch.max(output, 1)
            total_correct += (predicted == target).sum().item()
            pred_probs.extend(torch.nn.functional.softmax(output, dim=1)[:, 1].cpu().numpy())
            targets.extend(target.cpu().numpy())
    auc = roc_auc_score(targets, pred_probs)
    return auc

def main():
    parser = argparse.ArgumentParser()
    parser.add_argument('--dryrun', action='store_true')
    args = parser.parse_args()

    device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')
    X_train = torch.load('X_train.pth')
    Y_train = torch.load('Y_train.pth')
    X_val = torch.load('X_val.pth')
    Y_val = torch.load('Y_val.pth')

    if args.dryrun:
        print('Dry run: Exiting without training or saving the model')
        return

    dataset = EventDataset(X_train, Y_train)
    dataloader = DataLoader(dataset, batch_size=32, shuffle=True)
    model = BinaryClassifier()
    criterion = nn.CrossEntropyLoss()
    optimizer = torch.optim.Adam(model.parameters(), lr=0.001)

    for epoch in range(10):
        train(model, device, dataloader, optimizer, criterion)
        auc = evaluate(model, device, DataLoader(EventDataset(X_val, Y_val), batch_size=32, shuffle=False))
        print(f'Epoch {epoch+1}, AUC: {auc:.4f}')

    torch.save(model.state_dict(), 'binary_classifier_model.pth')
    print(f'Saved model to binary_classifier_model.pth')
    print(f'Final AUC score: {auc:.4f}')

if __name__ == '__main__':
    main()
",
