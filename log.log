  "code": "# ----- FIXED SECTION: Import Libraries -----\nimport os, sys, torch\nimport pandas as pd\nimport numpy as np\nimport matplotlib.pyplot as plt\nfrom torch import nn\nimport torch.nn.functional as F\nfrom torch.utils.data import TensorDataset, DataLoader\nfrom sklearn.metrics import roc_auc_score, accuracy_score\nimport math\n\n# Constants derived from dataset description and inspection\nN_FEATURES_TOTAL = 105\nN_MET_FEATURES = 2\nN_FEATURES_PER_OBJECT = 5 # Assuming obj_id, E, pT, eta, phi\nN_MAX_OBJECTS = (N_FEATURES_TOTAL - N_MET_FEATURES) // N_FEATURES_PER_OBJECT # Should be 20\n# Check if calculation is correct\nif (N_FEATURES_TOTAL - N_MET_FEATURES) % N_FEATURES_PER_OBJECT != 0:\n    print(f\"Warning: Feature dimension {N_FEATURES_TOTAL} might not be consistent with MET({N_MET_FEATURES}) + N_Objects*({N_FEATURES_PER_OBJECT})\")\n    # Simple fallback assuming 4 features (E, pT, eta, phi) and ignoring obj_id\n    if (N_FEATURES_TOTAL - N_MET_FEATURES) % 4 == 0:\n        N_FEATURES_PER_OBJECT = 4\n        N_MAX_OBJECTS = (N_FEATURES_TOTAL - N_MET_FEATURES) // N_FEATURES_PER_OBJECT\n        print(f\"Assuming {N_FEATURES_PER_OBJECT} features per object (E, pT, eta, phi). N_MAX_OBJECTS = {N_MAX_OBJECTS}\")\n    else:\n       # Fallback if neither 5 nor 4 features fit\n       # Use the calculation for 5 features and assume the remainder are some global features or padding\n       N_FEATURES_PER_OBJECT = 5\n       N_MAX_OBJECTS = (N_FEATURES_TOTAL - N_MET_FEATURES) // N_FEATURES_PER_OBJECT\n       print(f\"Assuming {N_FEATURES_PER_OBJECT} features per object and {N_MAX_OBJECTS} max objects. Remainder features unaccounted for.\")\n\nREMAINDER_FEATURES = N_FEATURES_TOTAL - N_MET_FEATURES - N_MAX_OBJECTS * N_FEATURES_PER_OBJECT\nPARTICLE_FEATURE_OFFSET = N_MET_FEATURES\n\n# ----- FIXED SECTION: Data Loading -----\ndef load_data():\n    X_train_df = pd.read_csv('./challenges/FOURTOPS/data/X_train.csv')\n    Y_train_df = pd.read_csv('./challenges/FOURTOPS/data/Y_train.csv')\n    X_val_df   = pd.read_csv('./challenges/FOURTOPS/data/X_val.csv')\n    Y_val_df   = pd.read_csv('./challenges/FOURTOPS/data/Y_val.csv')\n\n    X_train = torch.tensor(X_train_df.values, dtype=torch.float32)\n    Y_train = torch.tensor(Y_train_df.values, dtype=torch.long).squeeze()\n    X_val   = torch.tensor(X_val_df.values, dtype=torch.float32)\n    Y_val   = torch.tensor(Y_val_df.values, dtype=torch.long).squeeze()\n    return X_train, Y_train, X_val, Y_val\n\n# ----- FREE SECTION: Data Preprocessing -----\nclass PreprocessModule(torch.nn.Module):\n    def __init__(self, means, stds):\n        super().__init__()\n        self.register_buffer(\"means\", means)\n        self.register_buffer(\"stds\", stds.clamp(min=1e-6)) # Clamp std to avoid division by zero\n\n    def _extract_features(self, x):\n        # Extract MET\n        met_et = x[:, 0]\n        met_phi = x[:, 1]\n        met_x = met_et * torch.cos(met_phi)\n        met_y = met_et * torch.sin(met_phi)\n        met_features = torch.stack([met_et, met_x, met_y], dim=1) # Shape (B, 3)\n\n        # Extract particles\n        particles_flat = x[:, PARTICLE_FEATURE_OFFSET : PARTICLE_FEATURE_OFFSET + N_MAX_OBJECTS * N_FEATURES_PER_OBJECT]\n        particles = particles_flat.view(-1, N_MAX_OBJECTS, N_FEATURES_PER_OBJECT)\n\n        # Expected order: obj_id, E, pT, eta, phi\n        obj_id = particles[:, :, 0]\n        E = particles[:, :, 1]\n        pT = particles[:, :, 2]\n        eta = particles[:, :, 3]\n        phi = particles[:, :, 4]\n\n        # Create mask for real particles (pT > 0)\n        mask = (pT > 1e-6).float() # Use a small threshold to avoid float issues # Shape (B, N)\n\n        # Convert to Cartesian 4-vectors (apply mask to avoid NaN from log(0) in sinh(eta) for padded)\n        # Mask eta before sinh\n        # Clamp pT slightly for safety in calculations\n        pT_masked = pT * mask\n        eta_masked = eta * mask # Mask eta to avoid potentially large sinh values for padding\n\n        px = pT_masked * torch.cos(phi)\n        py = pT_masked * torch.sin(phi)\n        # Check for large eta values before sinh\n        pz = torch.where(torch.abs(eta_masked) < 10, pT_masked * torch.sinh(eta_masked), torch.zeros_like(pT_masked))\n        # Combine E, px, py, pz\n        p4 = torch.stack([E, px, py, pz], dim=-1) * mask.unsqueeze(-1) # Shape (B, N, 4)\n\n        # Combine all features (obj_id, p4, met, mask)\n        # Output features: MET (3), obj_id (N), p4 (N*4), mask (N)\n        # Order for normalization: met_et, met_x, met_y, obj_id, E, px, py, pz\n        feature_stack = torch.cat([\n            met_features, # 3 features\n            obj_id.unsqueeze(-1), # (B, N, 1)\n            p4 # (B, N, 4)\n        ], dim=-1) # This won't work easily because MET is global, particles are per-particle\n\n        # Instead return tuple\n        return met_features, obj_id, p4, mask\n\n    def forward(self, x: torch.Tensor) -> torch.Tensor:\n        met_features, obj_id, p4, mask = self._extract_features(x)\n\n        # Normalize features using stored mean/std\n        # means/stds order: met_et, met_x, met_y, obj_id, E, px, py, pz\n        met_f_norm = (met_features - self.means[0:3]) / self.stds[0:3]\n\n        # Normalize per-particle features\n        # Unsqueeze mean/std for broadcasting: shape (1, 1, num_features)\n        obj_id_mean = self.means[3].unsqueeze(0).unsqueeze(0)\n        obj_id_std = self.stds[3].unsqueeze(0).unsqueeze(0)\n        p4_means = self.means[4:].unsqueeze(0).unsqueeze(0) # Shape (1, 1, 4) for E, px, py, pz\n        p4_stds = self.stds[4:].unsqueeze(0).unsqueeze(0) # Shape (1, 1, 4)\n\n        obj_id_norm = (obj_id.unsqueeze(-1) - obj_id_mean) / obj_id_std * mask.unsqueeze(-1)\n        # Normalize E separately? pT? eta? phi? Maybe normalize p4 components is best\n        p4_norm = (p4 - p4_means) / p4_stds * mask.unsqueeze(-1) # Apply mask again after norm\n\n        # Return normalized features and mask. Concatenate for